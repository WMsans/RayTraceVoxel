#pragma kernel FindAffectedNodes

// --- structs ---
struct SVONode
{
    uint topology;
    uint payloadIndex; 
};

// --- Buffers ---
StructuredBuffer<SVONode> _NodeBuffer;
AppendStructuredBuffer<uint> _AffectedNodeBuffer; // Stores Indices of Nodes (Level 4)
AppendStructuredBuffer<uint> _DebugBuffer; // packed coord: z<<16 | y<<8 | x

// --- Uniforms ---
int3 _MinBrickIndex;
int3 _MaxBrickIndex;

// --- Helpers ---
// Duplicated from SVOBuilder.compute for now.
// In a real project, include a common .hlsl file.
uint GetNodeIndex(uint level, uint3 gridPos)
{
    uint offset = 0;
    if (level > 0) offset += 1;
    if (level > 1) offset += 8;
    if (level > 2) offset += 64;
    if (level > 3) offset += 512;

    uint3 p = gridPos;
    if (level == 0) p = uint3(0,0,0);
    else if (level == 1) p = p >> 3;
    else if (level == 2) p = p >> 2;
    else if (level == 3) p = p >> 1;
    
    uint m = 0;
    for (int i = 0; i < 4; i++) 
    {
        uint mask = 1 << i;
        m |= ((p.x & mask) ? (1 << (3*i)) : 0);
        m |= ((p.y & mask) ? (1 << (3*i + 1)) : 0);
        m |= ((p.z & mask) ? (1 << (3*i + 2)) : 0);
    }
    return offset + m;
}

[numthreads(8, 8, 8)]
void FindAffectedNodes(uint3 id : SV_DispatchThreadID)
{
    // 1. Calculate the Brick Index this thread is responsible for
    int3 brickIdx = _MinBrickIndex + (int3)id;

    // 2. Bounds Check (Thread ID might overshoot range)
    if (brickIdx.x > _MaxBrickIndex.x || 
        brickIdx.y > _MaxBrickIndex.y || 
        brickIdx.z > _MaxBrickIndex.z)
        return;

    // 3. Get Node Index for Level 4 (Leaf/Brick Pointer)
    uint nodeIndex = GetNodeIndex(4, (uint3)brickIdx);

    // 4. Check if it points to a payload
    // Note: Even if it doesn't (Empty space), if we are ADDING, we might need to know.
    // However, the prompt asks to find "Existing" nodes.
    // If we want to support Adding, we would simply return this NodeIndex, 
    // and the next step would check if it needs allocation.
    
    // For now, let's just append the NodeIndex.
    // The consumer (Step C) will read the node and see if payloadIndex == 0.
    
    _AffectedNodeBuffer.Append(nodeIndex);

    uint packedCoord = ((uint)brickIdx.z << 16) | ((uint)brickIdx.y << 8) | (uint)brickIdx.x;
    _DebugBuffer.Append(packedCoord);
}
