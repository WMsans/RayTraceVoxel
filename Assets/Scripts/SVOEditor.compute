#pragma kernel AllocateNodes
#pragma kernel EditVoxels

struct SVONode { uint topology; uint payloadIndex; };
struct VoxelPayload { uint brickDataIndex; }; // materialId removed

RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<float> _BrickBuffer;
RWStructuredBuffer<uint> _BrickMaterialBuffer; // NEW
RWStructuredBuffer<uint> _CounterBuffer;

// --- Uniforms ---
int3 _MinBrickIndex;
int3 _MaxBrickIndex;
float3 _BrushPosition;
float3 _BrushBounds;
float _BrushRadius;
int _BrushMaterialId;
int _BrushShape;
int _BrushOp;
float _Smoothness;
uint _MaxBricks;
float _GridSize;
static const uint BRICK_SIZE = 4;
static const float MAX_SDF = 10000.0;

// --- Helpers ---
// Polynomial Smooth Min (k = smoothness)
float smin(float a, float b, float k)
{
    if (k < 0.001) return min(a, b);
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return lerp(b, a, h) - k * h * (1.0 - h);
}

uint GetNodeIndex(uint level, uint3 gridPos)
{
    uint offset = 0;
    if (level > 0) offset += 1;
    if (level > 1) offset += 8;
    if (level > 2) offset += 64;
    if (level > 3) offset += 512;

    uint3 p = gridPos;
    if (level == 0) p = uint3(0,0,0);
    else if (level == 1) p = p >> 3;
    else if (level == 2) p = p >> 2;
    else if (level == 3) p = p >> 1;
    
    uint m = 0;
    for (int i = 0; i < 4; i++) 
    {
        uint mask = 1 << i;
        m |= ((p.x & mask) ? (1 << (3*i)) : 0);
        m |= ((p.y & mask) ? (1 << (3*i + 1)) : 0);
        m |= ((p.z & mask) ? (1 << (3*i + 2)) : 0);
    }
    return offset + m;
}

float GetBrushSDF(float3 p)
{
    float3 localP = p - _BrushPosition;
    
    if (_BrushShape == 0) // Sphere
    {
        return length(localP) - _BrushRadius;
    }
    else if (_BrushShape == 1) // Cube
    {
        float3 d = abs(localP) - _BrushBounds * 0.5;
        return length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
    }
    else if (_BrushShape == 2) // Plane (Infinite floor at Y)
    {
        // Simple plane: localP.y
        return localP.y;
    }
    return MAX_SDF;
}

[numthreads(8, 8, 8)]
void AllocateNodes(uint3 id : SV_DispatchThreadID)
{
    int3 brickIdx = _MinBrickIndex + (int3)id;
    if (brickIdx.x > _MaxBrickIndex.x || brickIdx.y > _MaxBrickIndex.y || brickIdx.z > _MaxBrickIndex.z) return;
    uint nodeIndex = GetNodeIndex(4, (uint3)brickIdx);
    
    if (_NodeBuffer[nodeIndex].payloadIndex == 0)
    {
        if (_BrushOp == 1) return; // Subtract
        
        float3 brickOrigin = (float3)brickIdx * (float)BRICK_SIZE;
        float3 brickCenter = brickOrigin + (float)BRICK_SIZE * 0.5;
        if (GetBrushSDF(brickCenter) > 3.5) return;

        uint payloadPtr, brickPtr;
        InterlockedAdd(_CounterBuffer[1], 1, payloadPtr);
        InterlockedAdd(_CounterBuffer[2], 64, brickPtr);
        payloadPtr += 1;

        if (brickPtr + 64 >= _MaxBricks * 64) return;

        // Initialize Data
        for (uint i = 0; i < 64; i++)
        {
            _BrickBuffer[brickPtr + i] = MAX_SDF;
            _BrickMaterialBuffer[brickPtr + i] = 0; // Default Air material
        }

        VoxelPayload pl;
        pl.brickDataIndex = brickPtr;
        // removed materialId
        
        _PayloadBuffer[payloadPtr] = pl;
        _NodeBuffer[nodeIndex].payloadIndex = payloadPtr;
        _NodeBuffer[nodeIndex].topology = 0;
    }
}

[numthreads(4, 4, 4)]
void EditVoxels(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    int3 brickIdx = _MinBrickIndex + (int3)groupID;
    if (brickIdx.x > _MaxBrickIndex.x || brickIdx.y > _MaxBrickIndex.y || brickIdx.z > _MaxBrickIndex.z) return;
    
    uint nodeIndex = GetNodeIndex(4, (uint3)brickIdx);
    uint payloadIdx = _NodeBuffer[nodeIndex].payloadIndex;
    if (payloadIdx == 0) return;

    VoxelPayload pl = _PayloadBuffer[payloadIdx];
    uint brickPtr = pl.brickDataIndex;
    uint3 voxelLocal = groupThreadID;
    uint voxelIndex = brickPtr + (voxelLocal.z * 16 + voxelLocal.y * 4 + voxelLocal.x);
    
    float3 brickOrigin = (float3)brickIdx * (float)BRICK_SIZE;
    float3 voxelPos = brickOrigin + (float3)voxelLocal;

    float brushVal = GetBrushSDF(voxelPos);
    float bias = 0.2; 
    if (_BrushOp == 1) brushVal -= bias;
    else if (_BrushOp == 0) brushVal += bias;

    float currentVal = _BrickBuffer[voxelIndex];
    float newVal = currentVal;
    float k = max(_Smoothness, 0.001);

    if (_BrushOp == 0) // Add
    {
        newVal = smin(currentVal, brushVal, k);
        // If brush is adding significant density, apply material
        if (brushVal < currentVal)
        {
             _BrickMaterialBuffer[voxelIndex] = _BrushMaterialId;
        }
    }
    else if (_BrushOp == 1) // Subtract
    {
        newVal = -smin(-currentVal, brushVal, k);
    }
    else if (_BrushOp == 2) // Paint
    {
        if (currentVal < 1.0 && brushVal < 0.0)
        {
             _BrickMaterialBuffer[voxelIndex] = _BrushMaterialId;
        }
    }

    _BrickBuffer[voxelIndex] = newVal;
}