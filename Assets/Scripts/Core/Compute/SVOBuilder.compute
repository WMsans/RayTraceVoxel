#pragma kernel InitDenseStructure
#pragma kernel BuildBricks
#pragma kernel PropagateLOD 

#include "./Includes/VoxelStructures.hlsl"
#include "./GeneratorPipeline.hlsl"

RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<float> _BrickBuffer; 
RWStructuredBuffer<uint> _BrickMaterialBuffer; 
RWStructuredBuffer<uint> _CounterBuffer; 

uint _GridSize;
float3 _ChunkWorldOrigin;
float _ChunkWorldSize;

// --- Global Offsets ---
uint _NodeOffset;
uint _PayloadOffset;
uint _BrickOffset;

[numthreads(64, 1, 1)]
void InitDenseStructure(uint id : SV_DispatchThreadID)
{
    if (id == 0) _CounterBuffer[0] = 4681;
    if (id >= 4681) return;
    
    SVONode node;
    node.payloadIndex = 0;
    node.topology = 0;
    node.lodColor = 0;
    node.lodMaterial = 0; // Init lodMaterial

    uint level = 0;
    uint indexInLevel = id;
    if (id >= 585) { level = 4; indexInLevel = id - 585;
    }
    else if (id >= 73) { level = 3; indexInLevel = id - 73;
    }
    else if (id >= 9) { level = 2; indexInLevel = id - 9;
    }
    else if (id >= 1) { level = 1; indexInLevel = id - 1;
    }
    
    if (level < 4)
    {
        uint nextLevelOffset = 0;
        if (level == 0) nextLevelOffset = 1;
        if (level == 1) nextLevelOffset = 9;
        if (level == 2) nextLevelOffset = 73;
        if (level == 3) nextLevelOffset = 585;
        uint childPtr = nextLevelOffset + (indexInLevel * 8);
        node.topology = (0xFF << 24) | (childPtr & 0xFFFFFF);
    }
    
    _NodeBuffer[_NodeOffset + id] = node;
}

[numthreads(4, 4, 4)]
void BuildBricks(uint3 id : SV_DispatchThreadID)
{
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (id.x >= bricksAxis || id.y >= bricksAxis || id.z >= bricksAxis) return;

    float3 brickOriginLocal = id * BRICK_SIZE;
    float3 brickCenterLocal = brickOriginLocal + (float)BRICK_SIZE * 0.5;
    float scale = _ChunkWorldSize / (float)_GridSize;
    float3 brickCenterWorld = _ChunkWorldOrigin + (brickCenterLocal * scale);
    float worldRadius = 3.0 * scale;

    // Use the pipeline to check intersection with the brick bounds
    GenerationContext centerCtx = RunGeneratorPipeline(brickCenterWorld);
    float dist = centerCtx.sdf;

    if (dist < worldRadius)
    {
        uint brickPtr;
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);
        float4 accumulatedColor = 0; // Accumulator
        float voxelCount = 0;
        uint detectedMaterial = 0;

        for (uint iz = 0; iz < BRICK_STORAGE_DIM; iz++)
        {
            for (uint iy = 0; iy < BRICK_STORAGE_DIM; iy++)
            {
                for (uint ix = 0; ix < BRICK_STORAGE_DIM; ix++)
                {
                    int x = (int)ix - BRICK_PADDING;
                    int y = (int)iy - BRICK_PADDING;
                    int z = (int)iz - BRICK_PADDING;

                    float3 voxelPosLocal = brickOriginLocal + float3(x, y, z);
                    float3 voxelPosWorld = _ChunkWorldOrigin + (voxelPosLocal * scale);
                    
                    // Run pipeline for each voxel
                    GenerationContext voxelCtx = RunGeneratorPipeline(voxelPosWorld);
                    float sdf = voxelCtx.sdf;

                    uint idx = _BrickOffset + brickPtr + (iz * BRICK_STORAGE_DIM * BRICK_STORAGE_DIM + iy * BRICK_STORAGE_DIM + ix);
                    _BrickBuffer[idx] = sdf / scale; 
                    
                    // Default to the material found at this voxel, or 1 if somehow 0 was returned but sdf < 0
                    uint mat = voxelCtx.material;
                    if (mat == 0) mat = 1; 
                    _BrickMaterialBuffer[idx] = mat;

                    // Accumulate Color for solid voxels (ONLY INSIDE BRICK)
                    if (x >= 0 && x < BRICK_SIZE && y >= 0 && y < BRICK_SIZE && z >= 0 && z < BRICK_SIZE)
                    {
                        if (sdf < 0) 
                        {
                            // Using white instead.
                            float3 col = float3(1.0, 1.0, 1.0); 
                            accumulatedColor += float4(col, 1.0);
                            voxelCount += 1.0;
                            detectedMaterial = mat; 
                        }
                    }
                }
            }
        }

        uint payloadIndex;
        InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
        payloadIndex += 1; 

        VoxelPayload payload;
        payload.brickDataIndex = brickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIndex] = payload;
        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[_NodeOffset + nodeIndex].payloadIndex = payloadIndex;
        _NodeBuffer[_NodeOffset + nodeIndex].topology = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodMaterial = detectedMaterial; // Store LOD material

        // Store Average Color in Leaf
        if (voxelCount > 0)
        {
            float density = voxelCount / 64.0;
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(accumulatedColor.rgb / voxelCount, density));
        }
        else
        {
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        }
    }
    else
    {
        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[_NodeOffset + nodeIndex].payloadIndex = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].topology = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodMaterial = 0;
    }
}

// --- Mipmapping Kernel ---
uint _TargetLevelOffset;
uint _TargetLevelCount;

[numthreads(64, 1, 1)]
void PropagateLOD(uint id : SV_DispatchThreadID)
{
    if (id >= _TargetLevelCount) return;
    uint nodeIndex = _TargetLevelOffset + id;
    SVONode node = _NodeBuffer[_NodeOffset + nodeIndex];

    if (node.topology == 0)
    {
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        return;
    }

    uint childBasePtr = node.topology & 0xFFFFFF; 

    float4 acc = 0;
    float count = 0;
    uint maxMaterial = 0;

    // Iterate 8 children
    for (int i = 0; i < 8; i++)
    {
        SVONode child = _NodeBuffer[_NodeOffset + childBasePtr + i];
        float4 c = UnpackColor(child.lodColor);
        
        if (c.a > 0.0) 
        {
            acc.rgb += c.rgb; // Accumulate Color
            acc.a += c.a;     // Accumulate Density
            count += 1.0;     // Track active children for Color Averaging
            if (child.lodMaterial != 0) maxMaterial = child.lodMaterial;
        }
    }

    if (count > 0.0)
    {
        // Color is average of ACTIVE children
        float3 avgColor = acc.rgb / count;
        
        // Alpha is average density of THE WHOLE NODE (8 octants)
        // This ensures sparse nodes get a very low alpha
        float nodeDensity = acc.a / 8.0; 

        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(avgColor, nodeDensity));
        _NodeBuffer[_NodeOffset + nodeIndex].lodMaterial = maxMaterial;
    }
    else
    {
         _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
         _NodeBuffer[_NodeOffset + nodeIndex].lodMaterial = 0;
    }
}
