#pragma kernel InitDenseStructure
#pragma kernel BuildBricks
#pragma kernel PropagateLOD 
#pragma kernel ApplySavedEdits
#pragma kernel ApplyDownsampledEdits 

#include "./Includes/VoxelStructures.hlsl"
#include "./GeneratorPipeline.hlsl"

// --- Global Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<uint> _BrickDataBuffer; 
RWStructuredBuffer<uint> _CounterBuffer;

// Dynamic SDF Buffers
StructuredBuffer<LBVHNode> _LBVHNodeBuffer;
StructuredBuffer<int> _SDFObjectIndexBuffer;

// --- Saved Edits Buffers ---
StructuredBuffer<uint> _SavedBrickData;
StructuredBuffer<uint> _SavedBrickIndices;

// --- Downsampling Buffers (New) ---
struct DownsampleTargetInfo
{
    uint targetBrickIdx; // Packed Local Coord (x | y<<8 | z<<16)
    int metaStartIndex;  // Index into _SourceBrickMeta
    int sourceCount;     // How many source bricks contribute
};

struct SourceBrickMeta
{
    uint relativeOffset; // Packed x,y,z (0..scale-1)
    int dataIndex;       // Index into _SavedBrickData
};

StructuredBuffer<DownsampleTargetInfo> _DownsampleTargets;
StructuredBuffer<SourceBrickMeta> _SourceBrickMeta;

// --- Global Uniforms ---
uint _GridSize;
float3 _ChunkWorldOrigin;
float _ChunkWorldSize;
uint _NodeOffset;
uint _PayloadOffset;
uint _BrickOffset;
int _NumDynamicObjects;
int _SavedEditCount;
int _DownsampleJobCount; // New
int _DownsampleScale;    // New (e.g. 2, 4)

uint _TargetLevelOffset;
uint _TargetLevelCount;

[numthreads(64, 1, 1)]
void InitDenseStructure(uint id : SV_DispatchThreadID)
{
    if (id == 0) _CounterBuffer[0] = 4681;
    if (id >= 4681) return;
    
    SVONode node;
    node.packedInfo = 0;
    node.topology = 0;
    node.lodColor = 0;
    uint level = 0;
    uint indexInLevel = id;
    if (id >= 585) { level = 4; indexInLevel = id - 585;
    }
    else if (id >= 73) { level = 3; indexInLevel = id - 73;
    }
    else if (id >= 9) { level = 2; indexInLevel = id - 9;
    }
    else if (id >= 1) { level = 1; indexInLevel = id - 1;
    }

    if (level < 4)
    {
        uint nextLevelOffset = 0;
        if (level == 0) nextLevelOffset = 1;
        if (level == 1) nextLevelOffset = 9;
        if (level == 2) nextLevelOffset = 73;
        if (level == 3) nextLevelOffset = 585;
        uint childPtr = nextLevelOffset + (indexInLevel * 8);
        node.topology = (0xFF << 24) | (childPtr & 0xFFFFFF);
    }
    _NodeBuffer[_NodeOffset + id] = node;
}

[numthreads(4, 4, 4)]
void BuildBricks(uint3 id : SV_DispatchThreadID)
{
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (id.x >= bricksAxis || id.y >= bricksAxis || id.z >= bricksAxis) return;
    // 1. Calculate Brick Bounds in World Space
    float3 brickOriginLocal = id * BRICK_SIZE;
    float3 brickCenterLocal = brickOriginLocal + (float)BRICK_SIZE * 0.5;
    float scale = _ChunkWorldSize / (float)_GridSize;
    float3 brickCenterWorld = _ChunkWorldOrigin + (brickCenterLocal * scale);
    float brickWorldRadius = (float)BRICK_SIZE * scale * 0.87;
    float3 brickMin = _ChunkWorldOrigin + ((brickOriginLocal - BRICK_PADDING) * scale);
    float3 brickMax = _ChunkWorldOrigin + ((brickOriginLocal + BRICK_SIZE + BRICK_PADDING) * scale);
    // 2. LBVH Traversal (Pre-pass)
    uint activeObjects[32];
    for(int i=0; i<32; i++) activeObjects[i] = 0;
    int activeCount = 0;

    if (_NumDynamicObjects > 0)
    {
        int stack[32];
        int stackPtr = 0;
        stack[0] = 0; // Root
        stackPtr++;
        while(stackPtr > 0 && activeCount < 32)
        {
            int nodeIdx = stack[--stackPtr];
            LBVHNode node = _LBVHNodeBuffer[nodeIdx];
            
            if (all(max(brickMin, node.boundsMin) <= min(brickMax, node.boundsMax)))
            {
                if (node.leftChild < 0) // Leaf
                {
                    int objIdx = ~node.leftChild;
                    int realIdx = _SDFObjectIndexBuffer[objIdx];
                    activeObjects[activeCount++] = realIdx;
                }
                else // Internal
                {
                    if(stackPtr < 30) 
                    {
                
                        stack[stackPtr++] = node.leftChild;
                        stack[stackPtr++] = node.rightChild;
                    }
                }
            }
        }
    }

    // [OPTIMIZATION] Early-Out for Terrain
    float worldRadius = 3.0 * scale;
    if (activeCount == 0)
    {
        // Sample terrain height at brick corners to estimate range
        // We use the 4 corners of the brick's XZ footprint
        float2 c1 = brickMin.xz;
        float2 c2 = float2(brickMax.x, brickMin.z);
        float2 c3 = float2(brickMin.x, brickMax.z);
        float2 c4 = brickMax.xz;
        
        float h1 = GetHeight(c1);
        float h2 = GetHeight(c2);
        float h3 = GetHeight(c3);
        float h4 = GetHeight(c4);
        
        float minH = min(min(h1, h2), min(h3, h4));
        float maxH = max(max(h1, h2), max(h3, h4));
        
        // Terrain SDF is approx (y - height) * 0.5
        // Surface band is where |y - height|
        // * 0.5 < worldRadius
        // So |y - height|
        // < worldRadius * 2.0
        
        float boundMargin = worldRadius * 2.0;
        // Check if Brick is completely above the surface band (Air)
        // brickMin.y > maxTerrainHeight + margin
        bool isFarAir = brickMin.y > (maxH + boundMargin);
        // Check if Brick is completely below the surface band (Deep Solid)
        // brickMax.y < minTerrainHeight - margin
        bool isDeepSolid = brickMax.y < (minH - boundMargin);
        if (isFarAir || isDeepSolid)
        {
             // Write Empty Node and Early Exit
            uint nodeIndex = GetNodeIndex(4, id);
            _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
            return;
        }
    }

    // 3. Evaluate SDF at Brick Center
    GenerationContext centerCtx = RunGeneratorPipeline(brickCenterWorld, activeObjects, activeCount);
    if (centerCtx.sdf < worldRadius)
    {
        uint brickPtr;
        // Allocate 216 voxels (6x6x6)
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);
        
        float4 accumulatedColor = 0;
        float voxelCount = 0;
        uint detectedMaterial = 0;

        // Iterate over storage size (6x6x6)
        for (uint z = 0; z < BRICK_STORAGE_SIZE; z++)
        {
            for (uint y = 0; y < BRICK_STORAGE_SIZE; y++)
            {
                for (uint x = 0; x < BRICK_STORAGE_SIZE; x++)
                {
                    int3 voxelOffset = int3(x, y, z) - int3(BRICK_PADDING, BRICK_PADDING, BRICK_PADDING);
                    float3 voxelPosLocal = brickOriginLocal + (float3)voxelOffset;
                    float3 voxelPosWorld = _ChunkWorldOrigin + (voxelPosLocal * scale);
                    
                    GenerationContext voxelCtx = RunGeneratorPipeline(voxelPosWorld, activeObjects, activeCount);
                    float sdf = voxelCtx.sdf;
                    uint mat = voxelCtx.material;
                    if (mat == 0) mat = 1;
                    // [OPTIMIZATION] Pack Data
                    // Normal, SDF, and Material are packed into a single uint
                    uint packedData = PackVoxelData(sdf / scale, voxelCtx.gradient, mat);
                    uint idx = _BrickOffset + brickPtr + (z * BRICK_STORAGE_SIZE * BRICK_STORAGE_SIZE + y * BRICK_STORAGE_SIZE + x);
                    _BrickDataBuffer[idx] = packedData;

                    // Accumulate for LOD (Inner 4x4x4 only)
                    if (x >= BRICK_PADDING && x < BRICK_STORAGE_SIZE - BRICK_PADDING &&
                        y >= BRICK_PADDING && y < BRICK_STORAGE_SIZE - BRICK_PADDING &&
                        z >= BRICK_PADDING && 
                        z < BRICK_STORAGE_SIZE - BRICK_PADDING)
                    {
                        if (sdf < 0) 
                        {
                        
                             float3 col = float3(1.0, 1.0, 1.0);
                             accumulatedColor += float4(col, 1.0);
                             voxelCount += 1.0;
                             detectedMaterial = mat;
                        }
                    }
                }
            }
        }

        uint payloadIndex;
        InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
        payloadIndex += 1; 

        VoxelPayload payload;
        payload.brickDataIndex = brickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIndex] = payload;
        uint nodeIndex = GetNodeIndex(4, id);

        // Pack Payload (16) |
        // Material (8)
        uint packed = (payloadIndex & 0xFFFF) |
        ((detectedMaterial & 0xFF) << 16);
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = packed;
        if (voxelCount > 0)
        {
            float density = voxelCount / (float)(BRICK_SIZE * BRICK_SIZE * BRICK_SIZE);
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(accumulatedColor.rgb / voxelCount, density));
        }
        else
        {
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        }
    }
    else
    {
        // Empty Brick
        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
    }
}

[numthreads(64, 1, 1)]
void PropagateLOD(uint id : SV_DispatchThreadID)
{
    if (id >= _TargetLevelCount) return;
    uint nodeIndex = _TargetLevelOffset + id;
    SVONode node = _NodeBuffer[_NodeOffset + nodeIndex];
    if (node.topology == 0)
    {
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        return;
    }

    uint childBasePtr = node.topology & 0xFFFFFF; 
    float4 acc = 0;
    float count = 0;
    uint maxMaterial = 0;

    for (int i = 0; i < 8; i++)
    {
        SVONode child = _NodeBuffer[_NodeOffset + childBasePtr + i];
        float4 c = UnpackColor(child.lodColor);
        if (c.a > 0.0) 
        {
            acc.rgb += c.rgb;
            acc.a += c.a;
            count += 1.0;
            
            // Unpack Material from child
            uint childPayload, childMat;
            UnpackNode(child, childPayload, childMat);
            if (childMat != 0) maxMaterial = childMat;
        }
    }

    if (count > 0.0)
    {
        float3 avgColor = acc.rgb / count;
        float nodeDensity = acc.a / 8.0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(avgColor, nodeDensity));
        // Pack Material back (Internal nodes have Payload=0)
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = (maxMaterial & 0xFF) << 16;
    }
    else
    {
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
    }
}

[numthreads(64, 1, 1)]
void ApplySavedEdits(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_SavedEditCount) return;

    // 1. Unpack Local Brick Coordinates (x | y<<8 | z<<16)
    uint packedLoc = _SavedBrickIndices[id];
    uint3 localBrickIdx = uint3(packedLoc & 0xFF, (packedLoc >> 8) & 0xFF, (packedLoc >> 16) & 0xFF);

    // 2. Find the Leaf Node
    uint nodeIndex = GetNodeIndex(4, localBrickIdx);
    uint globalNodeIdx = _NodeOffset + nodeIndex;
    SVONode node = _NodeBuffer[globalNodeIdx];

    uint payloadIdx, matID;
    UnpackNode(node, payloadIdx, matID);

    // 3. Ensure Allocation (If procedural pass skipped it)
    if (payloadIdx == 0)
    {
        InterlockedAdd(_CounterBuffer[1], 1, payloadIdx);
        payloadIdx += 1; // 1-based

        uint brickPtr;
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);

        // Update Payload Buffer
        VoxelPayload pl;
        pl.brickDataIndex = brickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIdx] = pl;

        // Update Node (Preserve topology bits if any)
        // Set Payload and clear Material (will be set by loop below)
        _NodeBuffer[globalNodeIdx].packedInfo = (payloadIdx & 0xFFFF) | (node.packedInfo & 0xFFFF0000);
        
        // Refresh node local
        node = _NodeBuffer[globalNodeIdx];
    }

    // 4. Overwrite Data & Calculate LOD stats
    VoxelPayload payload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint brickPtr = payload.brickDataIndex;
    uint srcOffset = id * BRICK_VOXEL_COUNT;
    uint dstBase = _BrickOffset + brickPtr;

    float4 accumulatedColor = 0;
    float voxelCount = 0;
    uint detectedMaterial = 0;

    for (uint i = 0; i < BRICK_VOXEL_COUNT; i++)
    {
        uint data = _SavedBrickData[srcOffset + i];
        _BrickDataBuffer[dstBase + i] = data;

        // Re-calculate LOD info for this brick since we modified it
        // Map linear index 'i' to x,y,z
        uint z = i / 36;
        uint rem = i % 36;
        uint y = rem / 6;
        uint x = rem % 6;

        // Check inner 4x4x4
        if (x >= BRICK_PADDING && x < BRICK_STORAGE_SIZE - BRICK_PADDING &&
            y >= BRICK_PADDING && y < BRICK_STORAGE_SIZE - BRICK_PADDING &&
            z >= BRICK_PADDING && z < BRICK_STORAGE_SIZE - BRICK_PADDING)
        {
             float sdf; float3 n; uint m;
             UnpackVoxelData(data, sdf, n, m);
             if (sdf < 0)
             {
                 accumulatedColor += float4(1,1,1,1); // Assuming white albedo for now
                 voxelCount += 1.0;
                 detectedMaterial = m;
             }
        }
    }

    // 5. Update Leaf Node LOD
    if (voxelCount > 0)
    {
        float density = voxelCount / (float)(BRICK_SIZE * BRICK_SIZE * BRICK_SIZE);
        _NodeBuffer[globalNodeIdx].lodColor = PackColor(float4(accumulatedColor.rgb / voxelCount, density));
        // Update Material ID in packed info
        uint currentPacked = _NodeBuffer[globalNodeIdx].packedInfo;
        _NodeBuffer[globalNodeIdx].packedInfo = (currentPacked & 0xFFFF00FF) | ((detectedMaterial & 0xFF) << 16);
    }
    else
    {
        _NodeBuffer[globalNodeIdx].lodColor = 0;
    }
}

uint3 Unpack3(uint packed)
{
    return uint3(packed & 0xFF, (packed >> 8) & 0xFF, (packed >> 16) & 0xFF);
}

[numthreads(6, 6, 6)]
void ApplyDownsampledEdits(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    // 1. Identify Job and Target Brick
    int jobIndex = groupID.x;
    if (jobIndex >= _DownsampleJobCount) return;

    DownsampleTargetInfo job = _DownsampleTargets[jobIndex];
    uint3 targetBrickLoc = Unpack3(job.targetBrickIdx);

    // 2. Get Target Brick Data Pointer
    // We need to find the node and payload to get the pointer.
    // NOTE: BuildBricks should have already allocated this brick and generated procedural terrain.
    uint nodeIndex = GetNodeIndex(4, targetBrickLoc);
    uint globalNodeIdx = _NodeOffset + nodeIndex;
    SVONode node = _NodeBuffer[globalNodeIdx];
    
    uint payloadIdx, matID;
    UnpackNode(node, payloadIdx, matID);
    
    // If procedural generation skipped this brick (e.g. Empty Air), we must allocate it now
    if (payloadIdx == 0)
    {
        InterlockedAdd(_CounterBuffer[1], 1, payloadIdx);
        payloadIdx += 1;
        uint newBrickPtr;
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, newBrickPtr);
        
        VoxelPayload pl;
        pl.brickDataIndex = newBrickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIdx] = pl;
        
        // Update Node
        _NodeBuffer[globalNodeIdx].packedInfo = (payloadIdx & 0xFFFF) | (node.packedInfo & 0xFFFF0000);
        
        // Initialize new brick to Air (safest default before overwrite)
        uint packedAir = PackVoxelData(MAX_SDF_RANGE, float3(0,1,0), 0);
        for(int k=0; k<BRICK_VOXEL_COUNT; k++) _BrickDataBuffer[_BrickOffset + newBrickPtr + k] = packedAir;
    }
    
    VoxelPayload payload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint brickPtr = payload.brickDataIndex;

    // 3. Current Voxel Processing (Low Res Voxel)
    uint3 voxelPos = groupThreadID; // 0..5, 0..5, 0..5 (includes padding)
    
    // Valid check: The brick is 6x6x6, we launched 6x6x6 threads.
    if (any(voxelPos >= BRICK_STORAGE_SIZE)) return;

    // 4. Accumulators for Downsampling
    float accSDF = 0;
    float3 accNormal = 0;
    float density = 0;
    float samples = 0;
    
    // Material Voting (Simplification: Track max frequency or dominant)
    // Here we just take the material of the closest surface found in source
    uint dominantMat = 0;
    float minAbsSDF = 10000.0; 

    // 5. Loop through High-Res Source Voxels
    // A single voxel in this Low-Res brick corresponds to a block of 'Scale' size in High-Res
    // However, we must handle the PADDING logic. 
    // The Source Data is stored as Bricks (4x4x4 + padding).
    // Mapping: LowResVoxel -> [Scale x Scale x Scale] block of HighResVoxels.
    
    // Inner loop: Iterate over the sub-voxels that make up this low-res voxel
    for (int sz = 0; sz < _DownsampleScale; sz++)
    {
        for (int sy = 0; sy < _DownsampleScale; sy++)
        {
            for (int sx = 0; sx < _DownsampleScale; sx++)
            {
                // Virtual Source Coordinate (Relative to Target Brick * Scale)
                // Note: We subtract padding to align the logical 4x4x4 cores, then add it back
                int3 logicalPos = (int3)voxelPos - BRICK_PADDING; // -1 .. 4
                int3 virtualSrcPos = logicalPos * _DownsampleScale + int3(sx, sy, sz); 
                
                // Now map virtualSrcPos to Source Bricks
                // We need to handle the case where virtualSrcPos crosses brick boundaries
                // Source Brick logic: 
                //   RelBrickIndex = floor(virtualSrcPos / 4)
                //   VoxelInBrick  = virtualSrcPos % 4
                
                // Shift to positive domain for division
                int3 offsetPos = virtualSrcPos + 1000 * 4; 
                int3 srcBrickRel = (offsetPos / 4) - 1000;
                int3 srcVoxelIdx = offsetPos % 4;

                // Adjust for Padding in the source storage (indices 1..4 are data)
                srcVoxelIdx += BRICK_PADDING; 

                // Find the specific Source Brick containing this voxel
                int foundDataIndex = -1;
                
                // Linear search through the source bricks assigned to this job
                // (Usually max 8 bricks for Scale=2, so fast enough)
                for (int m = 0; m < job.sourceCount; m++)
                {
                    SourceBrickMeta meta = _SourceBrickMeta[job.metaStartIndex + m];
                    uint3 metaRel = Unpack3(meta.relativeOffset);
                    
                    if (all(metaRel == (uint3)srcBrickRel))
                    {
                        foundDataIndex = meta.dataIndex;
                        break;
                    }
                }

                if (foundDataIndex != -1)
                {
                    // Sample Data
                    uint srcIdx = foundDataIndex * BRICK_VOXEL_COUNT + 
                                  (srcVoxelIdx.z * 36 + srcVoxelIdx.y * 6 + srcVoxelIdx.x);
                                  
                    uint val = _SavedBrickData[srcIdx];
                    
                    float s; float3 n; uint mat;
                    UnpackVoxelData(val, s, n, mat);
                    
                    accSDF += s;
                    accNormal += n;
                    samples += 1.0;
                    
                    if (s < 0) density += 1.0;
                    
                    if (abs(s) < minAbsSDF)
                    {
                        minAbsSDF = abs(s);
                        dominantMat = mat;
                    }
                }
                else
                {
                    // If source brick is missing, assume it's unedited (or Procedural)
                    // For correctness, we should sample procedural here, but that's expensive.
                    // We assume edits are sparse; if missing, we contribute "Neutral" or skip?
                    // We skip, effectively averaging only known edits.
                }
            }
        }
    }

    // 6. Write Result
    if (samples > 0)
    {
        float avgSDF = accSDF / samples;
        float3 avgNormal = normalize(accNormal + 1e-5); // Prevent NaN
        
        // Conflict Resolution / Blending
        uint targetIdx = _BrickOffset + brickPtr + (voxelPos.z * 36 + voxelPos.y * 6 + voxelPos.x);
        uint existingPacked = _BrickDataBuffer[targetIdx];
        
        float existingSDF; float3 existingNorm; uint existingMat;
        UnpackVoxelData(existingPacked, existingSDF, existingNorm, existingMat);
        
        // LOGIC: Overwrite if the edit significantly changes the SDF (Dominant Edit)
        // Since SavedData represents the "Truth" at LOD0 (Terrain + Edit), we largely trust it.
        // However, to avoid blocky artifacts at boundaries, we check if the Downsampled SDF
        // contradicts the Procedural SDF (e.g. Sign Flip) or is a strong surface.
        
        bool signFlip = (existingSDF > 0 && avgSDF < 0) || (existingSDF < 0 && avgSDF > 0);
        float delta = abs(existingSDF - avgSDF);
        
        // If the downsampled average is very different from procedural, we write it.
        if (signFlip || delta > 0.5)
        {
            // Rescale SDF for the current LOD level?
            // PackVoxelData expects World Space SDF / Scale ? 
            // The buffers store normalized SDF.
            // SavedData was packed with Scale=1. This target is Scale=N.
            // We averaged the World SDFs. Now we pack for current scale.
            
            // Note: PackVoxelData takes (sdf, ...). 
            // In BuildBricks: PackVoxelData(sdf / scale, ...).
            // So we must divide by _DownsampleScale (relative to chunk size? No, relative to Voxel Size).
            // Actually _DownsampleScale is the ratio.
            
            // Correction: The stored SDF in SavedData was packed as (TrueSDF / 1.0).
            // UnpackVoxelData returns the TrueSDF.
            // We averaged TrueSDFs.
            // Now we pack into a buffer where SDFs are expected to be (TrueSDF / CurrentScale).
            // The chunk logic uses 'scale' based on _ChunkWorldSize / _GridSize.
            // We can approximate this by dividing avgSDF by the downsample scale factor compared to LOD0.
            
            // But BuildBricks uses `scale` variable. We need that here.
            // `_DownsampleScale` is passed from C#.
            // Let's assume we need to normalize:
            
            _BrickDataBuffer[targetIdx] = PackVoxelData(avgSDF / (float)_DownsampleScale, avgNormal, dominantMat);
            
            // Update Node LOD Color if this is an inner voxel
             if (all(voxelPos >= BRICK_PADDING) && all(voxelPos < BRICK_STORAGE_SIZE - BRICK_PADDING))
             {
                 // We rely on PropagateLOD kernel to fix the colors later, 
                 // but we must ensure the material ID is updated in the node if we changed it.
                 if (dominantMat != 0)
                 {
                    uint info = _NodeBuffer[globalNodeIdx].packedInfo;
                    _NodeBuffer[globalNodeIdx].packedInfo = (info & 0xFFFF00FF) | ((dominantMat & 0xFF) << 16);
                 }
             }
        }
    }
}