#pragma kernel InitDenseStructure
#pragma kernel BuildBricks
#pragma kernel PropagateLOD 
#pragma kernel ApplySavedEdits
#pragma kernel StitchBrickBorders

#include "./Includes/VoxelStructures.hlsl"
#include "./GeneratorPipeline.hlsl"

// --- Global Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
// [OPTIMIZATION] Merged Buffer (Replaces BrickBuffer, MaterialBuffer, NormalBuffer)
RWStructuredBuffer<uint> _BrickDataBuffer; 

RWStructuredBuffer<uint> _CounterBuffer;

// Dynamic SDF Buffers
StructuredBuffer<LBVHNode> _LBVHNodeBuffer;
StructuredBuffer<int> _SDFObjectIndexBuffer;
// _SDFObjectBuffer is defined in GeneratorPipeline.hlsl

// --- Saved Edits Buffers (Phase 4) ---
StructuredBuffer<uint> _SavedBrickData;      // Flattened data (216 ints per brick)
StructuredBuffer<uint> _SavedBrickIndices;   // Packed Local Coordinates (x | y<<8 | z<<16)

// --- Global Uniforms ---
uint _GridSize;
float3 _ChunkWorldOrigin;
float _ChunkWorldSize;
uint _NodeOffset;
uint _PayloadOffset;
uint _BrickOffset;
int _NumDynamicObjects;
int _SavedEditCount;
int _ChunkDepth;

// Mipmapping Uniforms
uint _TargetLevelOffset;
uint _TargetLevelCount;

[numthreads(64, 1, 1)]
void InitDenseStructure(uint id : SV_DispatchThreadID)
{
    if (id == 0) _CounterBuffer[0] = 4681;
    if (id >= 4681) return;
    
    SVONode node;
    node.packedInfo = 0;
    node.topology = 0;
    node.lodColor = 0;
    uint level = 0;
    uint indexInLevel = id;
    if (id >= 585) { level = 4; indexInLevel = id - 585;
    }
    else if (id >= 73) { level = 3; indexInLevel = id - 73;
    }
    else if (id >= 9) { level = 2; indexInLevel = id - 9;
    }
    else if (id >= 1) { level = 1; indexInLevel = id - 1;
    }

    if (level < 4)
    {
        uint nextLevelOffset = 0;
        if (level == 0) nextLevelOffset = 1;
        if (level == 1) nextLevelOffset = 9;
        if (level == 2) nextLevelOffset = 73;
        if (level == 3) nextLevelOffset = 585;
        uint childPtr = nextLevelOffset + (indexInLevel * 8);
        node.topology = (0xFF << 24) | (childPtr & 0xFFFFFF);
    }
    _NodeBuffer[_NodeOffset + id] = node;
}

[numthreads(4, 4, 4)]
void BuildBricks(uint3 id : SV_DispatchThreadID)
{
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (id.x >= bricksAxis || id.y >= bricksAxis || id.z >= bricksAxis) return;
    // 1. Calculate Brick Bounds in World Space
    float3 brickOriginLocal = id * BRICK_SIZE;
    float3 brickCenterLocal = brickOriginLocal + (float)BRICK_SIZE * 0.5;
    float scale = _ChunkWorldSize / (float)_GridSize;
    float3 brickCenterWorld = _ChunkWorldOrigin + (brickCenterLocal * scale);
    float brickWorldRadius = (float)BRICK_SIZE * scale * 0.87;
    float3 brickMin = _ChunkWorldOrigin + ((brickOriginLocal - BRICK_PADDING) * scale);
    float3 brickMax = _ChunkWorldOrigin + ((brickOriginLocal + BRICK_SIZE + BRICK_PADDING) * scale);
    // 2. LBVH Traversal (Pre-pass)
    uint activeObjects[32];
    for(int i=0; i<32; i++) activeObjects[i] = 0;
    int activeCount = 0;

    if (_NumDynamicObjects > 0)
    {
        int stack[32];
        int stackPtr = 0;
        stack[0] = 0; // Root
        stackPtr++;
        while(stackPtr > 0 && activeCount < 32)
        {
            int nodeIdx = stack[--stackPtr];
            LBVHNode node = _LBVHNodeBuffer[nodeIdx];
            
            if (all(max(brickMin, node.boundsMin) <= min(brickMax, node.boundsMax)))
            {
                if (node.leftChild < 0) // Leaf
                {
                    int objIdx = ~node.leftChild;
                    int realIdx = _SDFObjectIndexBuffer[objIdx];
                    activeObjects[activeCount++] = realIdx;
                }
                else // Internal
                {
                    if(stackPtr < 30) 
                    {
                
                        stack[stackPtr++] = node.leftChild;
                        stack[stackPtr++] = node.rightChild;
                    }
                }
            }
        }
    }

    // [OPTIMIZATION] Early-Out for Terrain
    float worldRadius = 3.0 * scale;
    if (activeCount == 0)
    {
        // Sample terrain height at brick corners to estimate range
        // We use the 4 corners of the brick's XZ footprint
        float2 c1 = brickMin.xz;
        float2 c2 = float2(brickMax.x, brickMin.z);
        float2 c3 = float2(brickMin.x, brickMax.z);
        float2 c4 = brickMax.xz;
        
        float h1 = GetHeight(c1);
        float h2 = GetHeight(c2);
        float h3 = GetHeight(c3);
        float h4 = GetHeight(c4);
        
        float minH = min(min(h1, h2), min(h3, h4));
        float maxH = max(max(h1, h2), max(h3, h4));
        
        float boundMargin = worldRadius * 2.0;
        // Check if Brick is completely above the surface band (Air)
        bool isFarAir = brickMin.y > (maxH + boundMargin);
        // Check if Brick is completely below the surface band (Deep Solid)
        bool isDeepSolid = brickMax.y < (minH - boundMargin);
        if (isFarAir || isDeepSolid)
        {
             // Write Empty Node and Early Exit
            uint nodeIndex = GetNodeIndex(4, id);
            _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
            return;
        }
    }

    // 3. Evaluate SDF at Brick Center
    GenerationContext centerCtx = RunGeneratorPipeline(brickCenterWorld, activeObjects, activeCount);
    if (centerCtx.sdf < worldRadius)
    {
        uint brickPtr;
        // Allocate 216 voxels (6x6x6)
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);
        
        float4 accumulatedColor = 0;
        float voxelCount = 0;
        uint detectedMaterial = 0;

        // Iterate over storage size (6x6x6)
        for (uint z = 0; z < BRICK_STORAGE_SIZE; z++)
        {
            for (uint y = 0; y < BRICK_STORAGE_SIZE; y++)
            {
                for (uint x = 0; x < BRICK_STORAGE_SIZE; x++)
                {
                    int3 voxelOffset = int3(x, y, z) - int3(BRICK_PADDING, BRICK_PADDING, BRICK_PADDING);
                    float3 voxelPosLocal = brickOriginLocal + (float3)voxelOffset;
                    float3 voxelPosWorld = _ChunkWorldOrigin + (voxelPosLocal * scale);
                    
                    GenerationContext voxelCtx = RunGeneratorPipeline(voxelPosWorld, activeObjects, activeCount);
                    float sdf = voxelCtx.sdf;
                    uint mat = voxelCtx.material;
                    if (mat == 0) mat = 1;
                    // [OPTIMIZATION] Pack Data
                    uint packedData = PackVoxelData(sdf / scale, voxelCtx.gradient, mat);
                    uint idx = _BrickOffset + brickPtr + (z * BRICK_STORAGE_SIZE * BRICK_STORAGE_SIZE + y * BRICK_STORAGE_SIZE + x);
                    _BrickDataBuffer[idx] = packedData;

                    // Accumulate for LOD (Inner 4x4x4 only)
                    if (x >= BRICK_PADDING && x < BRICK_STORAGE_SIZE - BRICK_PADDING &&
                        y >= BRICK_PADDING && y < BRICK_STORAGE_SIZE - BRICK_PADDING &&
                        z >= BRICK_PADDING && 
                        z < BRICK_STORAGE_SIZE - BRICK_PADDING)
                    {
                        if (sdf < 0) 
                        {
                             float3 col = float3(1.0, 1.0, 1.0);
                             accumulatedColor += float4(col, 1.0);
                             voxelCount += 1.0;
                             detectedMaterial = mat;
                        }
                    }
                }
            }
        }

        uint payloadIndex;
        InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
        payloadIndex += 1; 

        VoxelPayload payload;
        payload.brickDataIndex = brickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIndex] = payload;
        uint nodeIndex = GetNodeIndex(4, id);

        uint packed = (payloadIndex & 0xFFFF) |
        ((detectedMaterial & 0xFF) << 16);
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = packed;
        if (voxelCount > 0)
        {
            float density = voxelCount / (float)(BRICK_SIZE * BRICK_SIZE * BRICK_SIZE);
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(accumulatedColor.rgb / voxelCount, density));
        }
        else
        {
            _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        }
    }
    else
    {
        // Empty Brick
        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
    }
}

[numthreads(64, 1, 1)]
void PropagateLOD(uint id : SV_DispatchThreadID)
{
    if (id >= _TargetLevelCount) return;
    uint nodeIndex = _TargetLevelOffset + id;
    SVONode node = _NodeBuffer[_NodeOffset + nodeIndex];
    if (node.topology == 0)
    {
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        return;
    }

    uint childBasePtr = node.topology & 0xFFFFFF; 
    float4 acc = 0;
    float count = 0;
    uint maxMaterial = 0;

    for (int i = 0; i < 8; i++)
    {
        SVONode child = _NodeBuffer[_NodeOffset + childBasePtr + i];
        float4 c = UnpackColor(child.lodColor);
        if (c.a > 0.0) 
        {
            acc.rgb += c.rgb;
            acc.a += c.a;
            count += 1.0;
            
            // Unpack Material from child
            uint childPayload, childMat;
            UnpackNode(child, childPayload, childMat);
            if (childMat != 0) maxMaterial = childMat;
        }
    }

    if (count > 0.0)
    {
        float3 avgColor = acc.rgb / count;
        float nodeDensity = acc.a / 8.0;
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = PackColor(float4(avgColor, nodeDensity));
        // Pack Material back (Internal nodes have Payload=0)
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = (maxMaterial & 0xFF) << 16;
    }
    else
    {
        _NodeBuffer[_NodeOffset + nodeIndex].lodColor = 0;
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
    }
}

[numthreads(64, 1, 1)]
void ApplySavedEdits(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_SavedEditCount) return;

    if (_ChunkDepth < 4) return;

    uint packedLoc = _SavedBrickIndices[id];
    uint3 localBrickIdx = uint3(packedLoc & 0xFF, (packedLoc >> 8) & 0xFF, (packedLoc >> 16) & 0xFF);

    uint nodeIndex = GetNodeIndex(4, localBrickIdx);
    uint globalNodeIdx = _NodeOffset + nodeIndex;
    SVONode node = _NodeBuffer[globalNodeIdx];

    uint payloadIdx, matID;
    UnpackNode(node, payloadIdx, matID);

    if (payloadIdx == 0)
    {
        InterlockedAdd(_CounterBuffer[1], 1, payloadIdx);
        payloadIdx += 1; // 1-based

        uint brickPtr;
        InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);

        VoxelPayload pl;
        pl.brickDataIndex = brickPtr;
        _PayloadBuffer[_PayloadOffset + payloadIdx] = pl;

        _NodeBuffer[globalNodeIdx].packedInfo = (payloadIdx & 0xFFFF) | (node.packedInfo & 0xFFFF0000);
        
        node = _NodeBuffer[globalNodeIdx];
    }

    VoxelPayload payload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint brickPtr = payload.brickDataIndex;
    uint srcOffset = id * BRICK_VOXEL_COUNT;
    uint dstBase = _BrickOffset + brickPtr;

    float4 accumulatedColor = 0;
    float voxelCount = 0;
    uint detectedMaterial = 0;

    for (uint i = 0; i < BRICK_VOXEL_COUNT; i++)
    {
        uint data = _SavedBrickData[srcOffset + i];
        _BrickDataBuffer[dstBase + i] = data;

        uint z = i / 36;
        uint rem = i % 36;
        uint y = rem / 6;
        uint x = rem % 6;

        if (x >= BRICK_PADDING && x < BRICK_STORAGE_SIZE - BRICK_PADDING &&
            y >= BRICK_PADDING && y < BRICK_STORAGE_SIZE - BRICK_PADDING &&
            z >= BRICK_PADDING && z < BRICK_STORAGE_SIZE - BRICK_PADDING)
        {
             float sdf; float3 n; uint m;
             UnpackVoxelData(data, sdf, n, m);
             if (sdf < 0)
             {
                 accumulatedColor += float4(1,1,1,1);
                 voxelCount += 1.0;
                 detectedMaterial = m;
             }
        }
    }

    if (voxelCount > 0)
    {
        float density = voxelCount / (float)(BRICK_SIZE * BRICK_SIZE * BRICK_SIZE);
        _NodeBuffer[globalNodeIdx].lodColor = PackColor(float4(accumulatedColor.rgb / voxelCount, density));
        uint currentPacked = _NodeBuffer[globalNodeIdx].packedInfo;
        _NodeBuffer[globalNodeIdx].packedInfo = (currentPacked & 0xFFFF00FF) | ((detectedMaterial & 0xFF) << 16);
    }
    else
    {
        _NodeBuffer[globalNodeIdx].lodColor = 0;
    }
}

[numthreads(4, 4, 4)]
void StitchBrickBorders(uint3 id : SV_DispatchThreadID)
{
    uint bricksPerAxis = _GridSize / BRICK_SIZE;
    if (any(id >= bricksPerAxis)) return;

    uint currentNodeIdx = GetNodeIndex(4, id);
    uint globalNodeIdx = _NodeOffset + currentNodeIdx;
    SVONode currentNode = _NodeBuffer[globalNodeIdx];
    
    uint payloadIdx, matID;
    UnpackNode(currentNode, payloadIdx, matID);
    
    if (payloadIdx == 0) return;
    
    VoxelPayload currentPayload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint currentBrickPtr = currentPayload.brickDataIndex;

    int3 directions[6] = {
        int3(-1, 0, 0), int3(1, 0, 0),
        int3(0, -1, 0), int3(0, 1, 0),
        int3(0, 0, -1), int3(0, 0, 1)
    };

    for(int i=0; i<6; i++) {
        int3 dir = directions[i];
        int3 neighborPos = (int3)id + dir;
        
        if (any(neighborPos < 0) || any(neighborPos >= (int)bricksPerAxis)) continue; 
        
        uint neighborNodeIdx = GetNodeIndex(4, (uint3)neighborPos);
        SVONode neighborNode = _NodeBuffer[_NodeOffset + neighborNodeIdx];
        
        uint nPayloadIdx, nMatID;
        UnpackNode(neighborNode, nPayloadIdx, nMatID);
        
        if (nPayloadIdx == 0) continue; 
        
        VoxelPayload nPayload = _PayloadBuffer[_PayloadOffset + nPayloadIdx];
        uint nBrickPtr = nPayload.brickDataIndex;
        
        for (uint u = 1; u <= 4; u++)
        {
            for (uint v = 1; v <= 4; v++)
            {
                uint3 srcPos = 0;
                uint3 dstPos = 0;

                if (dir.x == -1) 
                {
                    srcPos = uint3(4, u, v);
                    dstPos = uint3(0, u, v);
                }
                else if (dir.x == 1) 
                {
                    srcPos = uint3(1, u, v);
                    dstPos = uint3(5, u, v);
                }
                else if (dir.y == -1) 
                {
                    srcPos = uint3(u, 4, v);
                    dstPos = uint3(u, 0, v);
                }
                else if (dir.y == 1) 
                {
                    srcPos = uint3(u, 1, v);
                    dstPos = uint3(u, 5, v);
                }
                else if (dir.z == -1) 
                {
                    srcPos = uint3(u, v, 4);
                    dstPos = uint3(u, v, 0);
                }
                else if (dir.z == 1) 
                {
                    srcPos = uint3(u, v, 1);
                    dstPos = uint3(u, v, 5);
                }
                
                uint srcIdx = _BrickOffset + nBrickPtr + (srcPos.z * 36 + srcPos.y * 6 + srcPos.x);
                uint dstIdx = _BrickOffset + currentBrickPtr + (dstPos.z * 36 + dstPos.y * 6 + dstPos.x);
                
                _BrickDataBuffer[dstIdx] = _BrickDataBuffer[srcIdx];
            }
        }
    }
}