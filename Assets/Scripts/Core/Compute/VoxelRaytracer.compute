#pragma kernel CSMain

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "./Includes/VoxelStructures.hlsl"

// --- Global Monolithic Buffers ---
StructuredBuffer<SVONode> _GlobalNodeBuffer;
StructuredBuffer<VoxelPayload> _GlobalPayloadBuffer;
StructuredBuffer<float> _GlobalBrickBuffer;
StructuredBuffer<uint> _GlobalBrickMaterialBuffer;

// --- TLAS (Chunk Map) ---
StructuredBuffer<ChunkDef> _ChunkBuffer;
int _ChunkCount;

// --- Rendering Resources ---
StructuredBuffer<VoxelTypeGPU> _VoxelMaterialBuffer;
Texture2D<float> _CameraDepthTexture; SamplerState sampler_CameraDepthTexture;

Texture2DArray _AlbedoTextureArray;
Texture2DArray _NormalTextureArray;
Texture2DArray _MaskTextureArray;
SamplerState sampler_LinearRepeat { Filter = MIN_MAG_MIP_LINEAR; AddressU = Wrap; AddressV = Wrap; };

RWTexture2D<float4> _Result;
RWTexture2D<float> _ResultDepth;
RWStructuredBuffer<float4> _RaycastBuffer;

// --- Camera & Lighting ---
float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;
float4x4 _CameraViewProjection;

float4 _ZBufferParams;
float4 _MainLightPosition;
float4 _MainLightColor;
// x = PixelSpreadAngle (tan(FOV/2)*2/H)
float4 _RaytraceParams; 

#define MAX_ITERATIONS 128
#define MAX_MARCH_STEPS 64
#define EPSILON 0.002

// --- Utility Functions ---

float2 IntersectBox(float3 rayOrigin, float3 rayDir, float3 boxMin, float3 boxMax)
{
    float3 tMin = (boxMin - rayOrigin) / rayDir;
    float3 tMax = (boxMax - rayOrigin) / rayDir;
    float3 t1 = min(tMin, tMax);
    float3 t2 = max(tMin, tMax);
    float tNear = max(max(t1.x, t1.y), t1.z);
    float tFar = min(min(t2.x, t2.y), t2.z);
    return float2(tNear, tFar);
}

// Helper to get normal of a box surface
float3 GetBoxNormal(float3 hitPos, float3 boxMin, float3 boxSize)
{
    float3 center = boxMin + boxSize * 0.5;
    float3 p = hitPos - center;
    float3 d = abs(p) / (boxSize * 0.5);
    float maxAxis = max(max(d.x, d.y), d.z);
    
    // Return sign of dominant axis
    if (d.x >= maxAxis - 1e-4) return float3(sign(p.x), 0, 0);
    if (d.y >= maxAxis - 1e-4) return float3(0, sign(p.y), 0);
    return float3(0, 0, sign(p.z));
}

// Brick Sampling with Global Offset
float SampleBrick(uint brickOffset, uint brickPtr, float3 localPos)
{
    float3 p = localPos;
    int3 i = clamp((int3)floor(p), 0, 2);
    float3 f = p - (float3)i;
    uint baseIdx = brickOffset + brickPtr + i.z * 16 + i.y * 4 + i.x;
    
    float c000 = _GlobalBrickBuffer[baseIdx];
    float c001 = _GlobalBrickBuffer[baseIdx + 1];
    float c010 = _GlobalBrickBuffer[baseIdx + 4];
    float c011 = _GlobalBrickBuffer[baseIdx + 5];
    float c100 = _GlobalBrickBuffer[baseIdx + 16];
    float c101 = _GlobalBrickBuffer[baseIdx + 17];
    float c110 = _GlobalBrickBuffer[baseIdx + 20];
    float c111 = _GlobalBrickBuffer[baseIdx + 21];
    
    return lerp(lerp(lerp(c000, c001, f.x), lerp(c010, c011, f.x), f.y), lerp(lerp(c100, c101, f.x), lerp(c110, c111, f.x), f.y), f.z);
}

float3 CalculateNormal(uint brickOffset, uint brickPtr, float3 localPos)
{
    float d = 0.05;
    float dx = SampleBrick(brickOffset, brickPtr, localPos + float3(d,0,0)) - SampleBrick(brickOffset, brickPtr, localPos - float3(d,0,0));
    float dy = SampleBrick(brickOffset, brickPtr, localPos + float3(0,d,0)) - SampleBrick(brickOffset, brickPtr, localPos - float3(0,d,0));
    float dz = SampleBrick(brickOffset, brickPtr, localPos + float3(0,0,d)) - SampleBrick(brickOffset, brickPtr, localPos - float3(0,0,d));
    float3 v = float3(dx, dy, dz);
    return length(v) > 1e-6 ? normalize(v) : float3(0, 1, 0);
}

uint GetVoxelMaterial(uint brickOffset, uint brickPtr, float3 localPos)
{
    uint3 i = clamp((uint3)floor(localPos + 0.5), 0, 3);
    uint idx = brickOffset + brickPtr + i.z * 16 + i.y * 4 + i.x;
    return _GlobalBrickMaterialBuffer[idx];
}

float3 LightingPBR(float3 albedo, float3 N, float3 V, float3 L, float3 lightColor, float roughness) {
    float NdotL = max(0.0, dot(N, L));
    return albedo * lightColor * NdotL; 
}

void TriplanarSampling(float3 worldPos, float3 normal, uint matId, out float3 outAlbedo, out float3 outNormal, out float outRoughness, out float outAO)
{
    if (matId == 0) { outAlbedo=1; outNormal=normal; outRoughness=0.5; outAO=1; return; }
    
    VoxelTypeGPU mat = _VoxelMaterialBuffer[matId];
    // Simple triplanar weights
    float3 weights = abs(normal);
    weights /= (weights.x + weights.y + weights.z);

    // Sample Textures
    float2 uvX = worldPos.zy;
    float2 uvY = worldPos.xz;
    float2 uvZ = worldPos.xy;
    
    float3 colX = _AlbedoTextureArray.SampleLevel(sampler_LinearRepeat, float3(uvX, mat.sideAlbedoIndex), 0).rgb;
    float3 colY = _AlbedoTextureArray.SampleLevel(sampler_LinearRepeat, float3(uvY, mat.topAlbedoIndex), 0).rgb;
    float3 colZ = _AlbedoTextureArray.SampleLevel(sampler_LinearRepeat, float3(uvZ, mat.sideAlbedoIndex), 0).rgb;
    
    outAlbedo = colX * weights.x + colY * weights.y + colZ * weights.z;
    outNormal = normal; 
    outRoughness = 0.5;
    outAO = 1.0;
}

// --- CORE SVO TRAVERSAL (Local Space) ---
struct HitInfo { 
    bool hit;
    float3 pos; 
    float3 normal; 
    uint matId; 
    bool isLOD;      // New flag
    float3 lodColor; // Data for LOD
};

HitInfo TraceSVO(ChunkDef chunk, float3 rayOriginNode, float3 rayDir, float maxDist, float tStart)
{
    float tCurrent = tStart;
    float tEnd = maxDist;
    int iter = 0;
    
    float gridSz = 64.0; 
    float pixelSpread = _RaytraceParams.x;

    HitInfo result; 
    result.hit = false; result.pos = 0; result.normal = 0; result.matId = 0;
    result.isLOD = false; result.lodColor = 0; // Init
    
    while (tCurrent < tEnd && iter < MAX_ITERATIONS)
    {
        iter++;
        float3 pos = rayOriginNode + rayDir * (tCurrent + EPSILON);

        uint nodeIndex = 0;
        float nodeSize = gridSz;
        float3 nodePos = float3(0,0,0);
        bool hitLeaf = false;
        
        // Loop depth 0 to 5
        for (int depth = 0; depth < 5; depth++)
        {
            float halfSize = nodeSize * 0.5;
            float3 center = nodePos + halfSize;
            int octant = 0;
            if (pos.x >= center.x) octant |= 1;
            if (pos.y >= center.y) octant |= 2;
            if (pos.z >= center.z) octant |= 4;

            SVONode node = _GlobalNodeBuffer[chunk.nodeOffset + nodeIndex];
            uint childMask = (node.topology >> 24) & 0xFF;
            
            if ((childMask & (1 << octant)) != 0)
            {
                // Has Child
                uint childBase = node.topology & 0xFFFFFF;
                uint maskBefore = childMask & ((1 << octant) - 1);
                uint childNodeIndex = childBase + countbits(maskBefore);
                
                // --- PHASE 3: CONE TRACING / RAY SIZE CHECK ---
                float rayRadius = tCurrent * pixelSpread;
                if (nodeSize < rayRadius && depth > 1) 
                { 
                    // STOP TRAVERSAL: Fetch LOD Data
                    SVONode childNode = _GlobalNodeBuffer[chunk.nodeOffset + childNodeIndex];
                    float4 packedCol = UnpackColor(childNode.lodColor);
                    
                    if (packedCol.a > 0.0) // Only hit if it has content
                    {
                        hitLeaf = true;
                        result.isLOD = true;
                        result.lodColor = packedCol.rgb;
                        // For normal, we can approximate or use ray direction inverse
                        result.normal = -rayDir; 
                    }
                    // Else: It's empty air effectively, so we continue or break? 
                    // If we treat it as LOD block, we stop.
                    // But if lodColor is empty, it means the entire subtree is empty.
                    // So we should SKIP this block (advance tCurrent). 
                    // However, 'childMask' says there IS something there.
                    // Let's assume valid childMask implies valid content.
                    
                    // We need to set nodeIndex/Pos to the child so the Leaf Processing block handles the intersection
                    nodeIndex = childNodeIndex;
                    nodeSize = halfSize;
                    nodePos += float3((octant & 1) ? halfSize : 0, (octant & 2) ? halfSize : 0, (octant & 4) ? halfSize : 0);
                    break; 
                }

                // Normal Descent
                nodeIndex = childNodeIndex;
                nodeSize = halfSize;
                nodePos += float3((octant & 1) ? halfSize : 0, (octant & 2) ? halfSize : 0, (octant & 4) ? halfSize : 0);
                
                if (nodeSize <= BRICK_SIZE + EPSILON) { hitLeaf = true; break; }
            }
            else
            {
                 // Empty octant
                 float3 octantMin = nodePos + float3((octant & 1) ? halfSize : 0, (octant & 2) ? halfSize : 0, (octant & 4) ? halfSize : 0);
                 float2 tOctant = IntersectBox(rayOriginNode, rayDir, octantMin, octantMin + halfSize);
                 tCurrent = tOctant.y;
                 break;
            }
        }
        
        if (hitLeaf)
        {
            SVONode leafNode = _GlobalNodeBuffer[chunk.nodeOffset + nodeIndex];
            float2 tLeaf = IntersectBox(rayOriginNode, rayDir, nodePos, nodePos + nodeSize);
            
            // Check for LOD Hit first
            if (result.isLOD)
            {
                float tHit = max(tCurrent, tLeaf.x);
                if (tHit < tEnd)
                {
                    result.hit = true;
                    result.pos = rayOriginNode + rayDir * (tHit + EPSILON);
                    // result.normal set above
                    return result;
                }
            }
            else if (leafNode.payloadIndex != 0)
            {
                // STANDARD BRICK TRAVERSAL
                VoxelPayload payload = _GlobalPayloadBuffer[chunk.payloadOffset + leafNode.payloadIndex];
                uint brickPtr = payload.brickDataIndex;
                
                float tMarch = tCurrent;
                float marchEnd = min(tEnd, tLeaf.y);
                for (int m = 0; m < MAX_MARCH_STEPS; m++)
                {
                    if (tMarch >= marchEnd) break;
                    float3 p = rayOriginNode + rayDir * tMarch;
                    float3 localPos = p - nodePos;
                    float dist = SampleBrick(chunk.brickOffset, brickPtr, localPos);
                    if (dist < EPSILON)
                    {
                        result.hit = true;
                        result.pos = p;
                        result.normal = CalculateNormal(chunk.brickOffset, brickPtr, localPos);
                        result.matId = GetVoxelMaterial(chunk.brickOffset, brickPtr, localPos);
                        return result;
                    }
                    tMarch += max(dist, 0.05);
                }
            }
            tCurrent = tLeaf.y + EPSILON;
        }
    }
    return result;
}

// --- MAIN KERNEL ---

[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height; _Result.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    // 1. Generate Primary Ray
    float2 uv = (id.xy + 0.5) / float2(width, height) * 2.0 - 1.0;
    float4 viewRay = mul(_CameraInverseProjection, float4(uv, 0.0, 1.0));
    float3 rayDir = normalize(mul((float3x3)_CameraToWorld, viewRay.xyz));
    float3 rayOrigin = _CameraToWorld._m03_m13_m23;
    
    // 2. Depth Culling
    float depthVal = _CameraDepthTexture.SampleLevel(sampler_CameraDepthTexture, (id.xy+0.5)/float2(width,height), 0);
    float linearDepth = 1.0 / (_ZBufferParams.z * depthVal + _ZBufferParams.w);
    float3 forward = normalize(mul((float3x3)_CameraToWorld, float3(0,0,1)));
    float maxDist = linearDepth / max(dot(rayDir, forward), 0.0001);

    float closestT = maxDist;
    HitInfo bestHit; 
    bestHit.hit = false;
    bool anyHit = false;

    // STAGE A: World Search
    for (int i = 0; i < _ChunkCount; i++)
    {
        ChunkDef chunk = _ChunkBuffer[i];
        // Intersect Chunk Bounds (World Space)
        float2 tBox = IntersectBox(rayOrigin, rayDir, chunk.boundsMin, chunk.boundsMax);
        
        // If ray hits chunk and the hit is closer than our current best...
        if (tBox.x < tBox.y && tBox.x < closestT && tBox.y > 0)
        {
            float tStart = max(0.0, tBox.x);
            float tEnd = min(closestT, tBox.y); 
            
            // Transform Ray to Chunk Local Node Space
            float size = chunk.boundsMax.x - chunk.boundsMin.x;
            float scale = size / 64.0; 
            float3 chunkOrigin = chunk.boundsMin;
            float3 rayOriginNode = (rayOrigin - chunkOrigin) / scale;
            
            // STAGE B: Voxel Traversal
            HitInfo info = TraceSVO(chunk, rayOriginNode, rayDir, tEnd/scale, tStart/scale);
            if (info.hit)
            {
                // Convert hit back to World Space
                float3 hitWorld = chunkOrigin + info.pos * scale;
                float dist = length(hitWorld - rayOrigin);
                
                // Keep only the closest hit
                if (dist < closestT)
                {
                    closestT = dist;
                    bestHit = info;
                    bestHit.pos = hitWorld; 
                    anyHit = true;
                }
            }
        }
    }

    // 3. Shading & Output
    if (anyHit)
    {
        float3 albedo, normal;
        float roughness, ao;

        // Check for LOD Hit
        if (bestHit.isLOD)
        {
            albedo = bestHit.lodColor;
            normal = bestHit.normal; // Calculated based on view or stored
            roughness = 1.0; // Rough distant appearance
            ao = 1.0;
        }
        else
        {
            TriplanarSampling(bestHit.pos, bestHit.normal, bestHit.matId, albedo, normal, roughness, ao);
        }
        
        float3 V = normalize(rayOrigin - bestHit.pos);
        float3 L = normalize(_MainLightPosition.xyz);
        float3 color = LightingPBR(albedo, bestHit.normal, V, L, _MainLightColor.rgb, roughness);
        
        _Result[id.xy] = float4(color * ao, 1.0);
        
        // Write Depth 
        float4 clipPos = mul(_CameraViewProjection, float4(bestHit.pos, 1.0));
        _ResultDepth[id.xy] = clipPos.z / clipPos.w;
    }
    else
    {
        _Result[id.xy] = float4(0,0,0,0);
        _ResultDepth[id.xy] = 0.0;
    }
}