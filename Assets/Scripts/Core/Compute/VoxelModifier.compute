#pragma kernel AllocateNodesSphere
#pragma kernel EditVoxelsSphere
#pragma kernel AllocateNodesCube
#pragma kernel EditVoxelsCube

#include "./Includes/VoxelStructures.hlsl"

// --- Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<uint> _BrickDataBuffer;
RWStructuredBuffer<uint> _CounterBuffer;
// --- Uniforms ---
int3 _MinBrickIndex;
int3 _MaxBrickIndex;
float _GridSize;
int _MaxBricks;

// Offsets for Global Buffers
int _NodeOffset;
int _PayloadOffset;
int _BrickOffset;

float3 _BrushPosition; // In Voxel Coordinates
float3 _BrushBounds;   // In Voxel Coordinates
float _BrushRadius;    // In Voxel Coordinates
int _BrushMaterialId;
int _BrushOp; // 0=Add, 1=Subtract, 2=Paint
float _Smoothness;

// --- Helpers ---
// Simple traversal to find leaf node index for a grid position
// Returns -1 if not found or not leaf
int GetLeafNodeIndex(int3 gridPos)
{
    uint level = 4;
    uint index = GetNodeIndex(level, (uint3)gridPos); // From VoxelStructures.hlsl
    return index;
}

[numthreads(8, 8, 8)]
void AllocateNodesSphere(uint3 id : SV_DispatchThreadID)
{
    // Placeholder for sparse allocation logic
}

[numthreads(4, 4, 4)]
void EditVoxelsSphere(uint3 id : SV_DispatchThreadID)
{
    // id corresponds to a BRICK in the range [0..rangeX, 0..rangeY, 0..rangeZ]
    int3 brickIdx = _MinBrickIndex + (int3)id;
    if (any(brickIdx > _MaxBrickIndex)) return;
    
    // Find the node
    int nodeIndex = GetLeafNodeIndex(brickIdx);
    
    // [FIX] Apply NodeOffset
    SVONode node = _NodeBuffer[_NodeOffset + nodeIndex];
    uint payloadIdx, matID;
    UnpackNode(node, payloadIdx, matID);
    
    if (payloadIdx == 0) return; // No brick allocated here
    
    // [FIX] Apply PayloadOffset
    VoxelPayload payload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint brickPtr = payload.brickDataIndex;
    
    // Iterate over voxels in the brick (6x6x6)
    for (uint z = 0; z < BRICK_STORAGE_SIZE; z++)
    {
        for (uint y = 0; y < BRICK_STORAGE_SIZE; y++)
        {
            for (uint x = 0; x < BRICK_STORAGE_SIZE; x++)
            {
                // [FIX] Apply BrickOffset
                uint voxelIdx = _BrickOffset + brickPtr + z*36 + y*6 + x;
                uint packed = _BrickDataBuffer[voxelIdx];
                
                float sdf;
                float3 norm; uint mat;
                UnpackVoxelData(packed, sdf, norm, mat);
                
                // Reconstruct voxel position (Local to Volume in Voxel Units)
                int3 voxelOffset = int3(x,y,z) - int3(1,1,1); // Padding offset
                float3 voxelPosLocal = (float3)brickIdx * 4.0 + (float3)voxelOffset;

                // --- SDF Logic ---
                // _BrushPosition is now in Voxel Units
                float dist = length(voxelPosLocal - _BrushPosition) - _BrushRadius;

                if (_BrushOp == 0) // Add (Union)
                {
                    float h = clamp( 0.5 + 0.5 * (sdf - dist) / _Smoothness, 0.0, 1.0 );
                    sdf = lerp( sdf, dist, h ) - _Smoothness * h * (1.0 - h);
                    if (h < 0.5) mat = _BrushMaterialId;
                }
                else if (_BrushOp == 1) // Subtract
                {
                     float h = clamp( 0.5 - 0.5 * (sdf + dist) / _Smoothness, 0.0, 1.0 );
                     sdf = lerp( sdf, -dist, h ) + _Smoothness * h * (1.0 - h);
                }
                else if (_BrushOp == 2) // Paint
                {
                    if (dist < 0) mat = _BrushMaterialId;
                }
                
                _BrickDataBuffer[voxelIdx] = PackVoxelData(sdf, norm, mat);
            }
        }
    }
}

