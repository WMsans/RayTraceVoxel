#pragma kernel AllocateNodesSphere
#pragma kernel EditVoxelsSphere
#pragma kernel AllocateNodesCube
#pragma kernel EditVoxelsCube

#include "./Includes/VoxelStructures.hlsl"

// --- Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<uint> _BrickDataBuffer;
RWStructuredBuffer<uint> _CounterBuffer;

// --- Uniforms ---
int3 _MinBrickIndex;
int3 _MaxBrickIndex;
float _GridSize;
int _MaxBricks;

// Offsets for Global Buffers
int _NodeOffset;
int _PayloadOffset;
int _BrickOffset;

float3 _BrushPosition; // In Voxel Coordinates
float3 _BrushBounds;   // In Voxel Coordinates
float _BrushRadius;    // In Voxel Coordinates
int _BrushMaterialId;
int _BrushOp; // 0=Add, 1=Subtract, 2=Paint
float _Smoothness;

// --- Helpers ---
// Simple traversal to find leaf node index for a grid position
// Returns -1 if not found or not leaf
int GetLeafNodeIndex(int3 gridPos)
{
    uint level = 4;
    uint index = GetNodeIndex(level, (uint3)gridPos); // From VoxelStructures.hlsl
    return index;
}

[numthreads(8, 8, 8)]
void AllocateNodesSphere(uint3 id : SV_DispatchThreadID)
{
    int3 brickIdx = _MinBrickIndex + (int3)id;
    if (any(brickIdx > _MaxBrickIndex)) return;

    // 1. Check Intersection with Brush
    // Calculate Brick Center in Voxel Coords (Bricks are 4x4x4)
    float3 brickCenter = (float3)brickIdx * 4.0 + 2.0;
    // Conservative radius check: Brick Radius (~3.5) + Brush Radius
    float dist = length(brickCenter - _BrushPosition);
    if (dist > (_BrushRadius + 4.0)) return;

    // 2. Get Node
    int nodeIndex = GetLeafNodeIndex(brickIdx);
    // Apply NodeOffset
    uint globalNodeIndex = _NodeOffset + nodeIndex;
    SVONode node = _NodeBuffer[globalNodeIndex];

    // 3. Check if Empty (Payload Index == 0)
    uint existingPayload = node.packedInfo & 0xFFFF;
    if (existingPayload == 0)
    {
        // 4. Allocate New Resources
        uint newPayloadIdx;
        InterlockedAdd(_CounterBuffer[1], 1, newPayloadIdx);
        newPayloadIdx += 1; // 1-based index (0 is null)

        uint newBrickVoxelPtr;
        InterlockedAdd(_CounterBuffer[2], 216, newBrickVoxelPtr);
        
        // Safety Check: Prevent overwriting if pool is full
        if ((newBrickVoxelPtr + 216) > ((uint)_MaxBricks * 216)) return;

        // 5. Initialize Payload
        VoxelPayload pl;
        pl.brickDataIndex = newBrickVoxelPtr;
        _PayloadBuffer[_PayloadOffset + newPayloadIdx] = pl;
        
        // 6. Initialize Brick Data to "Air"
        // We must fill the new 4x4x4 block with safe default values 
        // so the edit kernel can blend correctly.
        // MAX_SDF_RANGE (4.0) represents empty space. 
        // Normal Up (0,1,0), Material 0.
        uint packedAir = PackVoxelData(MAX_SDF_RANGE, float3(0,1,0), 0);
        for (uint i = 0; i < 216; i++)
        {
            _BrickDataBuffer[_BrickOffset + newBrickVoxelPtr + i] = packedAir;
        }
        
        // 7. Link Node to New Payload
        // Preserve existing upper bits (though usually 0 for empty nodes)
        uint newPackedInfo = (newPayloadIdx & 0xFFFF) | (node.packedInfo & 0xFFFF0000);
        _NodeBuffer[globalNodeIndex].packedInfo = newPackedInfo;
    }
}

[numthreads(4, 4, 4)]
void EditVoxelsSphere(uint3 id : SV_DispatchThreadID)
{
    // id corresponds to a BRICK in the range [0..rangeX, 0..rangeY, 0..rangeZ]
    int3 brickIdx = _MinBrickIndex + (int3)id;
    if (any(brickIdx > _MaxBrickIndex)) return;
    
    // Find the node
    int nodeIndex = GetLeafNodeIndex(brickIdx);
    SVONode node = _NodeBuffer[_NodeOffset + nodeIndex];
    uint payloadIdx, matID;
    UnpackNode(node, payloadIdx, matID);
    if (payloadIdx == 0) return;
    // Should be allocated now if intersecting
    
    VoxelPayload payload = _PayloadBuffer[_PayloadOffset + payloadIdx];
    uint brickPtr = payload.brickDataIndex;
    
    // Iterate over voxels in the brick (6x6x6)
    for (uint z = 0; z < BRICK_STORAGE_SIZE; z++)
    {
        for (uint y = 0; y < BRICK_STORAGE_SIZE; y++)
        {
            for (uint x = 0; x < BRICK_STORAGE_SIZE; x++)
            {
                uint voxelIdx = _BrickOffset + brickPtr + z*36 + y*6 + x;
                uint packed = _BrickDataBuffer[voxelIdx];
                
                float sdf;
                float3 norm;
                uint mat;
                UnpackVoxelData(packed, sdf, norm, mat);
                
                // Reconstruct voxel position (Local to Volume in Voxel Units)
                int3 voxelOffset = int3(x,y,z) - int3(1,1,1);
                // Padding offset
                float3 voxelPosLocal = (float3)brickIdx * 4.0 + (float3)voxelOffset;
                
                // --- SDF Logic ---
                // _BrushPosition is now in Voxel Units
                float3 diff = voxelPosLocal - _BrushPosition;
                float distRaw = length(diff);
                float dist = distRaw - _BrushRadius;
                
                // Calculate gradient (normal) for the sphere
                float3 sphereNormal = (distRaw > 1e-5) ? diff / distRaw : float3(0,1,0);

                if (_BrushOp == 0) // Add (Union)
                {
                    float h = clamp( 0.5 + 0.5 * (sdf - dist) / _Smoothness, 0.0, 1.0 );
                    sdf = lerp( sdf, dist, h ) - _Smoothness * h * (1.0 - h);
                    
                    norm = normalize(lerp(norm, sphereNormal, h));
                    if (h > 0.5) mat = _BrushMaterialId;
                }
                else if (_BrushOp == 1) // Subtract
                {
                    float h = clamp( 0.5 - 0.5 * (sdf + dist) / _Smoothness, 0.0, 1.0 );
                    sdf = lerp( sdf, -dist, h ) + _Smoothness * h * (1.0 - h);

                    norm = normalize(lerp(norm, -sphereNormal, h));
                }
                else if (_BrushOp == 2) // Paint
                {
                    if (dist < 0) mat = _BrushMaterialId;
                }
                
                _BrickDataBuffer[voxelIdx] = PackVoxelData(sdf, norm, mat);
            }
        }
    }
}

