#pragma kernel InitDenseStructure
#pragma kernel BuildBricksFromGrid

#include "Includes/VoxelStructures.hlsl"

// --- Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<uint> _BrickDataBuffer;
RWStructuredBuffer<uint> _CounterBuffer;

// --- Source Data ---
StructuredBuffer<uint> _SourceGrid;
int3 _GridResolution;

// --- Uniforms ---
uint _NodeOffset;
uint _PayloadOffset;
uint _BrickOffset;
uint _GridSize; // Logical Resolution (e.g., 16 or 32)

// Reuse InitDenseStructure from SVOBuilder (Identical logic)
[numthreads(64, 1, 1)]
void InitDenseStructure(uint id : SV_DispatchThreadID)
{
    if (id == 0) _CounterBuffer[0] = 4681; // Max nodes for 32^3 grid (Depth 3)
    if (id >= 4681) return;
    
    SVONode node;
    node.packedInfo = 0;
    node.topology = 0;
    node.lodColor = 0;
    
    // Hardcoded fully dense topology for small objects (Depth 0 to 3)
    // Map ID to Level/Index... (Simplified for brevity: assumes valid dense tree structure)
    // [Actual implementation would mirror SVOBuilder.compute's logic]
    
    uint level = 0;
    uint indexInLevel = id;
    if (id >= 585) { level = 4; indexInLevel = id - 585; }
    else if (id >= 73) { level = 3; indexInLevel = id - 73; }
    else if (id >= 9) { level = 2; indexInLevel = id - 9; }
    else if (id >= 1) { level = 1; indexInLevel = id - 1; }

    if (level < 4)
    {
        uint nextLevelOffset = (level == 0) ? 1 : (level == 1 ? 9 : (level == 2 ? 73 : 585));
        uint childPtr = nextLevelOffset + (indexInLevel * 8);
        node.topology = (0xFF << 24) | (childPtr & 0xFFFFFF);
    }
    _NodeBuffer[_NodeOffset + id] = node;
}

[numthreads(4, 4, 4)]
void BuildBricksFromGrid(uint3 id : SV_DispatchThreadID)
{
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (any(id >= bricksAxis)) return;

    // 1. Check if this brick has any solid voxels in the source grid
    bool isEmpty = true;
    uint3 baseVoxel = id * BRICK_SIZE;
    
    // Quick sampling of the source grid
    for(uint z=0; z<BRICK_SIZE; z++)
    for(uint y=0; y<BRICK_SIZE; y++)
    for(uint x=0; x<BRICK_SIZE; x++)
    {
        uint3 v = baseVoxel + uint3(x,y,z);
        if (all(v < (uint3)_GridResolution))
        {
            uint idx = v.z * _GridResolution.x * _GridResolution.y + v.y * _GridResolution.x + v.x;
            float sdf; float3 n; uint mat;
            UnpackVoxelData(_SourceGrid[idx], sdf, n, mat);
            if (sdf < 2.0) { isEmpty = false; break; } // < 2.0 considers surface
        }
    }

    uint nodeIndex = GetNodeIndex(4, id);

    if (isEmpty)
    {
        _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = 0;
        return;
    }

    // 2. Allocate Brick
    uint brickPtr;
    InterlockedAdd(_CounterBuffer[2], BRICK_VOXEL_COUNT, brickPtr);

    // 3. Fill Brick
    for (uint z = 0; z < BRICK_STORAGE_SIZE; z++)
    {
        for (uint y = 0; y < BRICK_STORAGE_SIZE; y++)
        {
            for (uint x = 0; x < BRICK_STORAGE_SIZE; x++)
            {
                int3 voxelOffset = int3(x, y, z) - int3(BRICK_PADDING, BRICK_PADDING, BRICK_PADDING);
                int3 samplePos = (int3)baseVoxel + voxelOffset;
                
                uint packedData = 0; // Default Air
                
                // Boundary Check
                if (all(samplePos >= 0) && all(samplePos < _GridResolution))
                {
                    uint idx = samplePos.z * _GridResolution.x * _GridResolution.y + samplePos.y * _GridResolution.x + samplePos.x;
                    packedData = _SourceGrid[idx];
                }
                else
                {
                    // Clamp to border or default
                    packedData = PackVoxelData(4.0, float3(0,1,0), 0);
                }

                uint destIdx = _BrickOffset + brickPtr + (z * 36 + y * 6 + x);
                _BrickDataBuffer[destIdx] = packedData;
            }
        }
    }

    // 4. Link Node
    uint payloadIndex;
    InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
    payloadIndex += 1;

    VoxelPayload payload;
    payload.brickDataIndex = brickPtr;
    _PayloadBuffer[_PayloadOffset + payloadIndex] = payload;

    _NodeBuffer[_NodeOffset + nodeIndex].packedInfo = (payloadIndex & 0xFFFF) | (1 << 16); // Mat ID 1 generic
}