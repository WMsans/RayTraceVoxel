#pragma kernel BuildBricks

// --- Structs ---
struct SVONode
{
    uint topology; 
    uint payloadIndex;
};

struct VoxelPayload
{
    uint brickDataIndex;
    uint materialId;
};

// --- Buffers ---
RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<float> _BrickBuffer; // Raw SDF values
RWStructuredBuffer<uint> _CounterBuffer; // 0: Nodes, 1: Payloads, 2: BrickFloats

// --- Settings ---
uint _GridSize;
static const uint BRICK_SIZE = 4;

// --- Morton Encoding ---
uint ExpandBits(uint v)
{
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint MortonEncode3(uint3 pos)
{
    return ExpandBits(pos.x) | (ExpandBits(pos.y) << 1) | (ExpandBits(pos.z) << 2);
}

// --- SDF Function ---
float GetSDF(float3 pos)
{
    float sizeF = (float)_GridSize;
    float3 center = float3(sizeF / 2.0, sizeF / 2.0, sizeF / 2.0);
    float radius = sizeF / 3.0;
    // Simple sphere
    return length(pos - center) - radius;
}

[numthreads(8, 8, 8)]
void BuildBricks(uint3 id : SV_DispatchThreadID)
{
    // ID corresponds to the coordinate of the BRICK (not the voxel)
    // E.g., ID (0,0,0) is the first 4x4x4 block.
    
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (id.x >= bricksAxis || id.y >= bricksAxis || id.z >= bricksAxis) return;

    // 1. Check if this brick contains surface (Conservative check)
    // Sample center of the brick
    float3 brickOrigin = id * BRICK_SIZE;
    float3 brickCenter = brickOrigin + (float)BRICK_SIZE * 0.5;
    
    float dist = GetSDF(brickCenter);
    
    // Diagonal of a 4x4x4 cube is sqrt(16+16+16) approx 6.9
    // Plus some padding for the band
    float activeThreshold = (float)BRICK_SIZE * 0.866 + 2.0; 

    if (abs(dist) < activeThreshold)
    {
        // 2. Allocate
        uint nodeIndex, payloadIndex, brickFloatPtr;
        InterlockedAdd(_CounterBuffer[0], 1, nodeIndex);
        InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
        InterlockedAdd(_CounterBuffer[2], BRICK_SIZE * BRICK_SIZE * BRICK_SIZE, brickFloatPtr);

        // Safety
        uint maxNodes, stride;
        _NodeBuffer.GetDimensions(maxNodes, stride);
        if (nodeIndex >= maxNodes) return;

        // 3. Fill the Brick (64 loops - Unrolled or looped)
        // We write the SDF values directly to the BrickBuffer
        // Flattened Index: z * 16 + y * 4 + x
        for (uint z = 0; z < BRICK_SIZE; z++)
        {
            for (uint y = 0; y < BRICK_SIZE; y++)
            {
                for (uint x = 0; x < BRICK_SIZE; x++)
                {
                    float3 voxelPos = brickOrigin + float3(x, y, z);
                    float sdf = GetSDF(voxelPos);
                    
                    uint localIndex = (z * BRICK_SIZE * BRICK_SIZE) + (y * BRICK_SIZE) + x;
                    _BrickBuffer[brickFloatPtr + localIndex] = sdf;
                }
            }
        }

        // 4. Create Node & Payload
        // We use the Brick coordinate for Morton Code to sort them later
        uint morton = MortonEncode3(id);
        
        SVONode node;
        node.topology = (0xFF << 24) | (morton & 0xFFFFFF); // Store Morton in ChildPtr slot for Linear Sort
        node.payloadIndex = payloadIndex;

        VoxelPayload payload;
        payload.brickDataIndex = brickFloatPtr;
        payload.materialId = 1;

        _NodeBuffer[nodeIndex] = node;
        _PayloadBuffer[payloadIndex] = payload;
    }
}