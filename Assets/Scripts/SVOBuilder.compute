#pragma kernel InitDenseStructure
#pragma kernel BuildBricks

struct SVONode
{
    uint topology; 
    uint payloadIndex; 
};

struct VoxelPayload
{
    uint brickDataIndex;
    uint materialId;
};

RWStructuredBuffer<SVONode> _NodeBuffer;
RWStructuredBuffer<VoxelPayload> _PayloadBuffer;
RWStructuredBuffer<float> _BrickBuffer; 
RWStructuredBuffer<uint> _CounterBuffer; 

uint _GridSize;
static const uint BRICK_SIZE = 4;

uint GetNodeIndex(uint level, uint3 gridPos)
{
    uint offset = 0;
    if (level > 0) offset += 1;
    if (level > 1) offset += 8;
    if (level > 2) offset += 64;
    if (level > 3) offset += 512;

    uint3 p = gridPos;
    if (level == 0) p = uint3(0,0,0);
    else if (level == 1) p = p >> 3;
    else if (level == 2) p = p >> 2;
    else if (level == 3) p = p >> 1;
    
    uint m = 0;
    for (int i = 0; i < 4; i++) 
    {
        uint mask = 1 << i;
        m |= ((p.x & mask) ? (1 << (3*i)) : 0);
        m |= ((p.y & mask) ? (1 << (3*i + 1)) : 0);
        m |= ((p.z & mask) ? (1 << (3*i + 2)) : 0);
    }
    return offset + m;
}

[numthreads(64, 1, 1)]
void InitDenseStructure(uint id : SV_DispatchThreadID)
{
    if (id >= 4681) return;
    
    SVONode node;
    node.payloadIndex = 0;
    node.topology = 0;

    uint level = 0;
    uint indexInLevel = id;
    if (id >= 585) { level = 4; indexInLevel = id - 585; }
    else if (id >= 73) { level = 3; indexInLevel = id - 73; }
    else if (id >= 9) { level = 2; indexInLevel = id - 9; }
    else if (id >= 1) { level = 1; indexInLevel = id - 1; }
    
    if (level < 4)
    {
        uint nextLevelOffset = 0;
        if (level == 0) nextLevelOffset = 1;
        if (level == 1) nextLevelOffset = 9;
        if (level == 2) nextLevelOffset = 73;
        if (level == 3) nextLevelOffset = 585;

        uint childPtr = nextLevelOffset + (indexInLevel * 8);
        node.topology = (0xFF << 24) | (childPtr & 0xFFFFFF);
    }
    
    _NodeBuffer[id] = node;
}

// --- SIMPLIFIED SDF ---
float GetSDF(float3 pos)
{
    float sizeF = (float)_GridSize;
    float3 center = float3(sizeF * 0.5, sizeF * 0.5, sizeF * 0.5);
    
    // Huge Box: 40% of grid size radius (covers 80% of volume)
    float3 d = abs(pos - center) - float3(sizeF * 0.4, sizeF * 0.4, sizeF * 0.4);
    return min(max(d.x, max(d.y, d.z)), 0.0) + length(max(d, 0.0));
}

[numthreads(8, 8, 8)]
void BuildBricks(uint3 id : SV_DispatchThreadID)
{
    uint bricksAxis = _GridSize / BRICK_SIZE;
    if (id.x >= bricksAxis || id.y >= bricksAxis || id.z >= bricksAxis) return;

    float3 brickOrigin = id * BRICK_SIZE;
    float3 brickCenter = brickOrigin + (float)BRICK_SIZE * 0.5;
    
    // Check if brick is potentially relevant
    // Since we want to ensure visibility, we check a large threshold
    float activeThreshold = (float)BRICK_SIZE * 1.5; 
    float dist = GetSDF(brickCenter);

    // Build if inside (negative) or near surface
    if (dist < activeThreshold)
    {
        uint brickFloatPtr;
        InterlockedAdd(_CounterBuffer[2], 64, brickFloatPtr);

        for (uint z = 0; z < BRICK_SIZE; z++)
        {
            for (uint y = 0; y < BRICK_SIZE; y++)
            {
                for (uint x = 0; x < BRICK_SIZE; x++)
                {
                    float3 voxelPos = brickOrigin + float3(x, y, z);
                    float sdf = GetSDF(voxelPos);
                    _BrickBuffer[brickFloatPtr + (z*16 + y*4 + x)] = sdf;
                }
            }
        }

        uint payloadIndex;
        InterlockedAdd(_CounterBuffer[1], 1, payloadIndex);
        payloadIndex += 1; 

        VoxelPayload payload;
        payload.brickDataIndex = brickFloatPtr;
        payload.materialId = 1;
        _PayloadBuffer[payloadIndex] = payload;

        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[nodeIndex].payloadIndex = payloadIndex;
        _NodeBuffer[nodeIndex].topology = 0;
    }
    else
    {
        uint nodeIndex = GetNodeIndex(4, id);
        _NodeBuffer[nodeIndex].payloadIndex = 0;
        _NodeBuffer[nodeIndex].topology = 0;
    }
}