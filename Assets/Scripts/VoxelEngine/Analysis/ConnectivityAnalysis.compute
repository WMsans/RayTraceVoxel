#pragma kernel InitializeAnalysis
#pragma kernel FloodFill
#pragma kernel IdentifyIslands

#include "../Shared/Shaders/Includes/VoxelStructures.hlsl"

// --- Buffers ---
// Input: The voxel data from the edited region
StructuredBuffer<uint> _InputVoxelBuffer; // Packed voxels
int3 _RegionSize; // Size of the analyzed region in voxels
int3 _RegionOffset; // Start coordinate of the region

// Output: Analysis results
RWStructuredBuffer<int> _ConnectivityMap; // 0 = Empty, 1 = Solid (Unvisited), 2 = Visited/Connected
RWStructuredBuffer<uint> _IslandVoxels;   // List of voxels belonging to islands
RWStructuredBuffer<uint> _IslandCounter;  // Atomic counter for island voxels

int _MaxIterations;

// Helper to unpack solidity from uint (Assuming standard packed format)
bool IsSolid(uint packedData)
{
    // Check Material ID (Bottom 8 bits)
    // If Material ID > 0, it is solid.
    return (packedData & 0xFF) > 0;
}

// 1D Index to 3D Coord
int3 IndexToCoord(int index)
{
    int x = index % _RegionSize.x;
    int y = (index / _RegionSize.x) % _RegionSize.y;
    int z = index / (_RegionSize.x * _RegionSize.y);
    return int3(x, y, z);
}

// 3D Coord to 1D Index
int CoordToIndex(int3 coord)
{
    if (any(coord < 0) || any(coord >= _RegionSize)) return -1;
    return coord.z * _RegionSize.x * _RegionSize.y + coord.y * _RegionSize.x + coord.x;
}

[numthreads(8, 8, 8)]
void InitializeAnalysis (uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_RegionSize)) return;

    int index = CoordToIndex(id);
    uint voxel = _InputVoxelBuffer[index];

    // Mark solid voxels as "Unvisited" (1), Empty as 0
    if (IsSolid(voxel))
    {
        _ConnectivityMap[index] = 1; 
        
        // Seed the flood fill from the "floor" or a known anchor
        // For simplicity: If y == 0, consider it grounded/connected
        if (id.y == 0) 
        {
            _ConnectivityMap[index] = 2; // Visited
        }
    }
    else
    {
        _ConnectivityMap[index] = 0;
    }
}

[numthreads(8, 8, 8)]
void FloodFill (uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_RegionSize)) return;

    // Direct 3D coordinate from dispatch - no division needed
    int3 coord = (int3)id;
    int index = CoordToIndex(coord);

    if (_ConnectivityMap[index] == 2) // If I am connected
    {
        // Check 6 neighbors
        int3 neighbors[6] = {
            int3(1, 0, 0), int3(-1, 0, 0),
            int3(0, 1, 0), int3(0, -1, 0),
            int3(0, 0, 1), int3(0, 0, -1)
        };

        for (int i = 0; i < 6; i++)
        {
            int3 nCoord = coord + neighbors[i];
            int nIndex = CoordToIndex(nCoord);

            if (nIndex != -1)
            {
                // If neighbor is Solid Unvisited (1), mark as Connected (2)
                int oldVal;
                InterlockedCompareExchange(_ConnectivityMap[nIndex], 1, 2, oldVal);
            }
        }
    }
}

[numthreads(8, 8, 8)]
void IdentifyIslands (uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_RegionSize)) return;

    int index = CoordToIndex(id);
    
    // If state is still 1 (Solid Unvisited), it's an island
    if (_ConnectivityMap[index] == 1)
    {
        uint writeIdx;
        InterlockedAdd(_IslandCounter[0], 1, writeIdx);
        _IslandVoxels[writeIdx] = index; // Store the index of the floating voxel
    }
}
