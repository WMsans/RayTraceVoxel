// --- Sampling ---
float GetDensity(int3 pos)
{
    // Handle bounds
    if (any(pos < 0) || any(pos > _GridSize)) return 1.0;

    int3 nodeCoord = pos / BRICK_SIZE; // BRICK_SIZE is 4
    int3 localPos = pos % BRICK_SIZE;
    
    // Boundary handling for sampling from the padding of the previous block
    if (nodeCoord.x >= (_GridSize / BRICK_SIZE)) { nodeCoord.x--; localPos.x += BRICK_SIZE; }
    if (nodeCoord.y >= (_GridSize / BRICK_SIZE)) { nodeCoord.y--; localPos.y += BRICK_SIZE; }
    if (nodeCoord.z >= (_GridSize / BRICK_SIZE)) { nodeCoord.z--; localPos.z += BRICK_SIZE; }

    uint nodeIndex = GetNodeIndex(4, (uint3)nodeCoord);
    uint physIndex = GetPhysicalIndex(nodeIndex, _NodeOffset, _PageTableBuffer);
    SVONode node = _NodeBuffer[physIndex];

    if (node.packedInfo & NODE_FLAG_SOLID)
    {
        // Solid means filled. Density is negative.
        return -1.0;
    }
    
    if (node.packedInfo == 0)
    {
        // Empty
        return 1.0;
    }

    uint payloadIndex; uint materialID;
    UnpackNode(node, payloadIndex, materialID);
    
    VoxelPayload payload = _PayloadBuffer[GetPhysicalIndex(payloadIndex, _PayloadOffset, _PageTableBuffer)];
    
    // Calculate index in brick with padding
    // localPos is 0..3 (or up to 7 with boundary trick)
    // BRICK_PADDING is 1
    // BRICK_STORAGE_SIZE is 6
    // If localPos is 4 (boundary), index = 5, which is valid.
    int3 storagePos = localPos + int3(BRICK_PADDING, BRICK_PADDING, BRICK_PADDING);
    
    // Clamp to be safe, though logic should hold
    storagePos = clamp(storagePos, 0, BRICK_STORAGE_SIZE - 1);
    
    uint brickPtr = payload.brickDataIndex;
    uint dataIdx = _BrickOffset + brickPtr + (storagePos.z * BRICK_STORAGE_SIZE * BRICK_STORAGE_SIZE + storagePos.y * BRICK_STORAGE_SIZE + storagePos.x);
    
    uint packedData = _BrickDataBuffer[dataIdx];
    float sdf; float3 n; uint mat;
    UnpackVoxelData(packedData, sdf, n, mat);
    
    return sdf;
}

float3 Interpolate(float3 p1, float3 p2, float v1, float v2)
{
    if (abs(v1 - v2) < 0.00001) return p1;
    float t = (0.0 - v1) / (v2 - v1);
    return lerp(p1, p2, t);
}

[numthreads(8, 8, 8)]
void GeneratePhysicsMesh(uint3 id : SV_DispatchThreadID)
{
    uint dim = _GridSize / _Stride;
    if (any(id >= dim)) return;

    float3 pos0 = id * _Stride;
    
    // Sample 8 corners
    float v[8];
    v[0] = GetDensity(pos0 + int3(0, 0, 0) * _Stride);
    v[1] = GetDensity(pos0 + int3(1, 0, 0) * _Stride);
    v[2] = GetDensity(pos0 + int3(1, 0, 1) * _Stride);
    v[3] = GetDensity(pos0 + int3(0, 0, 1) * _Stride);
    v[4] = GetDensity(pos0 + int3(0, 1, 0) * _Stride);
    v[5] = GetDensity(pos0 + int3(1, 1, 0) * _Stride);
    v[6] = GetDensity(pos0 + int3(1, 1, 1) * _Stride);
    v[7] = GetDensity(pos0 + int3(0, 1, 1) * _Stride);

    int cubeIndex = 0;
    if (v[0] < 0) cubeIndex |= 1;
    if (v[1] < 0) cubeIndex |= 2;
    if (v[2] < 0) cubeIndex |= 4;
    if (v[3] < 0) cubeIndex |= 8;
    if (v[4] < 0) cubeIndex |= 16;
    if (v[5] < 0) cubeIndex |= 32;
    if (v[6] < 0) cubeIndex |= 64;
    if (v[7] < 0) cubeIndex |= 128;

    if (edgeTable[cubeIndex] == 0) return;

    // Vertices of the cell
    float scale = _ChunkWorldSize / (float)_GridSize;
    float3 localBase = pos0 * scale;
    float strideStep = _Stride * scale;
    
    float3 p[8];
    p[0] = localBase;
    p[1] = localBase + float3(strideStep, 0, 0);
    p[2] = localBase + float3(strideStep, 0, strideStep);
    p[3] = localBase + float3(0, 0, strideStep);
    p[4] = localBase + float3(0, strideStep, 0);
    p[5] = localBase + float3(strideStep, strideStep, 0);
    p[6] = localBase + float3(strideStep, strideStep, strideStep);
    p[7] = localBase + float3(0, strideStep, strideStep);

    float3 vertList[12];
    if (edgeTable[cubeIndex] & 1) vertList[0] = Interpolate(p[0], p[1], v[0], v[1]);
    if (edgeTable[cubeIndex] & 2) vertList[1] = Interpolate(p[1], p[2], v[1], v[2]);
    if (edgeTable[cubeIndex] & 4) vertList[2] = Interpolate(p[2], p[3], v[2], v[3]);
    if (edgeTable[cubeIndex] & 8) vertList[3] = Interpolate(p[3], p[0], v[3], v[0]);
    if (edgeTable[cubeIndex] & 16) vertList[4] = Interpolate(p[4], p[5], v[4], v[5]);
    if (edgeTable[cubeIndex] & 32) vertList[5] = Interpolate(p[5], p[6], v[5], v[6]);
    if (edgeTable[cubeIndex] & 64) vertList[6] = Interpolate(p[6], p[7], v[6], v[7]);
    if (edgeTable[cubeIndex] & 128) vertList[7] = Interpolate(p[7], p[4], v[7], v[4]);
    if (edgeTable[cubeIndex] & 256) vertList[8] = Interpolate(p[0], p[4], v[0], v[4]);
    if (edgeTable[cubeIndex] & 512) vertList[9] = Interpolate(p[1], p[5], v[1], v[5]);
    if (edgeTable[cubeIndex] & 1024) vertList[10] = Interpolate(p[2], p[6], v[2], v[6]);
    if (edgeTable[cubeIndex] & 2048) vertList[11] = Interpolate(p[3], p[7], v[3], v[7]);

    for (int i = 0; triTable[cubeIndex][i] != -1; i += 3)
    {
        _VertexOutput.Append(vertList[triTable[cubeIndex][i]]);
        _VertexOutput.Append(vertList[triTable[cubeIndex][i+1]]);
        _VertexOutput.Append(vertList[triTable[cubeIndex][i+2]]);
    }
}
